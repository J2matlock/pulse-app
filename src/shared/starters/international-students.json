{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "international-students",
  "name": "International student advisor",
  "description": "For international student offices: program end dates, the OPT window (90 days before to 60 days after the program ends) and I-20, passport and visa expiries. Pulse is a tracking aid, not your official record system.",
  "icon": "graduation-cap",
  "group": "Education and youth",
  "vocab": {
    "record": {
      "one": "student",
      "many": "students",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "students",
      "name": "International students",
      "description": "Students with program end dates, OPT windows and document expiries",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Country",
          "column_type": "text",
          "position": 1,
          "width": 130
        },
        {
          "name": "Program",
          "column_type": "text",
          "position": 2,
          "width": 190
        },
        {
          "name": "Program end date",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "OPT applied",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date the OPT application was filed",
          "config": "{\"alert_rule_name\":\"OPT application window\",\"log_changes\":true}"
        },
        {
          "name": "I-20 end date",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Passport expires",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Visa expires",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 8,
          "width": 200
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 130,
          "config": "{\"options\":[\"Enrolled\",\"On OPT\",\"Transferred\",\"Completed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "OPT application window",
          "description": "OPT can be applied for from 90 days before to 60 days after the program ends",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":150,\"bgClass\":\"#bbf7d0\",\"label\":\"Window opens\"},{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Window open\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Closing soon\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Last day\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Window closed\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Program end date\"},\"offset\":{\"days\":60,\"direction\":\"after\"}}"
        },
        {
          "name": "Expires (90-day warning)",
          "description": "The date entered is when it expires; warns 90, 60, 30 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":90,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":60,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":30,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "advising",
      "label": "Advising",
      "icon": "🎓",
      "color": "teal"
    }
  ],
