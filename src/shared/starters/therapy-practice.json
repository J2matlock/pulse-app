{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "therapy-practice",
  "name": "Therapy & counseling",
  "description": "For therapists and counselors: weekly sessions on the calendar, authorized sessions counted as you write session notes, treatment plan reviews every 90 days, PHQ-9 and GAD-7 scores over time and an intake form. Pulse is a tracking aid, not your official record system.",
  "icon": "brain",
  "group": "Health",
  "vocab": {
    "record": {
      "one": "client",
      "many": "clients",
      "article": "a"
    },
    "list": {
      "one": "caseload",
      "many": "caseloads",
      "article": "a"
    },
    "activity": {
      "one": "session note",
      "many": "session notes",
      "article": "a"
    },
    "worker": {
      "one": "therapist",
      "many": "therapists",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": true,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true,
    "appointments": true,
    "forms": true,
    "attachments": true
  },
  "lists": [
    {
      "key": "clients",
      "name": "Clients",
      "description": "Everyone you see, with their authorization, plan review and screening scores",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 140
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140
        },
        {
          "name": "Insurance",
          "column_type": "dropdown",
          "position": 3,
          "width": 150,
          "config": "{\"options\":[\"Medicaid\",\"Blue Plan\",\"Choice Health\",\"Employee assistance\",\"Self-pay\"]}"
        },
        {
          "name": "Main concern",
          "column_type": "dropdown",
          "position": 4,
          "width": 150,
          "config": "{\"options\":[\"Anxiety\",\"Depression\",\"Grief\",\"Trauma\",\"Relationships\",\"Stress\",\"Other\"]}"
        },
        {
          "name": "Sessions authorized",
          "column_type": "number",
          "position": 5,
          "width": 130
        },
        {
          "name": "Authorization start",
          "column_type": "date",
          "position": 6,
          "width": 140
        },
        {
          "name": "Authorization end",
          "column_type": "date",
          "position": 7,
          "width": 140
        },
        {
          "name": "Sessions left",
          "column_type": "deadline",
          "position": 8,
          "width": 140,
          "description": "Sessions used against the authorization, and when it ends",
          "config": "{\"alert_rule_name\":\"Sessions left\"}"
        },
        {
          "name": "Treatment plan review",
          "column_type": "date",
          "position": 9,
          "width": 160,
          "description": "Date the treatment plan was last reviewed; due again every 90 days",
          "config": "{\"alert_rule_name\":\"Every 90 days\",\"log_changes\":true}"
        },
        {
          "name": "Consent signed",
          "column_type": "date",
          "position": 10,
          "width": 140,
          "description": "Consent and release forms; renewed every year",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "PHQ-9",
          "column_type": "number",
          "position": 11,
          "width": 100,
          "description": "Latest depression screening score (0–27). Earlier scores show as a chart on the page.",
          "config": "{\"log_changes\":true}"
        },
        {
          "name": "GAD-7",
          "column_type": "number",
          "position": 12,
          "width": 100,
          "description": "Latest anxiety screening score (0–21). Earlier scores show as a chart on the page.",
          "config": "{\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 13,
          "width": 130,
          "config": "{\"options\":[\"Intake\",\"Active\",\"On hold\",\"Discharged\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Sessions left",
          "description": "Counts sessions between the authorization start and end dates",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":15,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\":\"quota\",\"activityTypes\":[\"session\"],\"limitColumnId\":{\"column\":\"Sessions authorized\"},\"startColumnId\":{\"column\":\"Authorization start\"},\"endColumnId\":{\"column\":\"Authorization end\"},\"warnRemaining\":2,\"warnDaysBeforeEnd\":14}"
        },
        {
          "name": "Every 90 days",
          "description": "Due 90 days after the date entered",
          "interval_days": 90,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":15,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "forms": [
        {
          "name": "Intake",
          "intro": "Fill this in with a new client at the first session, or print a blank for the waiting room.",
          "log_activity_type": "session",
          "fields": [
            {
              "kind": "section",
              "title": "About you"
            },
            {
              "kind": "column",
              "column": "Name",
              "required": true
            },
            {
              "kind": "column",
              "column": "Date of birth",
              "width": "half"
            },
            {
              "kind": "column",
              "column": "Phone",
              "width": "half"
            },
            {
              "kind": "column",
              "column": "Insurance",
              "width": "half"
            },
            {
              "kind": "column",
              "column": "Main concern",
              "width": "half"
            },
            {
              "kind": "section",
              "title": "What brings you in",
              "text": "In your own words. Write as much or as little as you like."
            },
            {
              "kind": "note",
              "label": "What would you like help with?",
              "required": true
            },
            {
              "kind": "note",
              "label": "What have you tried so far?"
            },
            {
              "kind": "section",
              "title": "Screening scores"
            },
            {
              "kind": "column",
              "column": "PHQ-9",
              "width": "half",
              "help": "0–27"
            },
            {
              "kind": "column",
              "column": "GAD-7",
              "width": "half",
              "help": "0–21"
            },
            {
              "kind": "column",
              "column": "Consent signed",
              "label": "Consent signed on"
            }
          ]
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "session",
      "label": "Session",
      "icon": "💬",
      "color": "teal"
    },
    {
      "key": "phone",
      "label": "Phone",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "no_show",
      "label": "No-show",
      "icon": "🚫",
      "color": "red"
    },
    {
      "key": "cancelled",
      "label": "Cancellation",
      "icon": "❌",
      "color": "amber"
    }
  ],
  "documentTemplates": [
    {
      "name": "Authorization renewal request",
      "content": "{{today}}\n\nRe: {{name}}, born {{field:Date of birth}}\nInsurance: {{field:Insurance}}\n\nThe current authorization of {{field:Sessions authorized}} sessions ends on {{field:Authorization end}}. Treatment is ongoing and we are asking for more sessions to continue the current plan.\n\nThe treatment plan was last reviewed on {{field:Treatment plan review}}.\n\nThank you,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "SOAP notes",
      "body": "Choose the SOAP format when you write a session note to get Subjective, Objective, Assessment and Plan headings every time."
    },
    {
      "title": "Weekly sessions",
      "body": "On a client's page, add an appointment and choose Repeat weekly. End it on the Authorization end date so the series stops when the authorization does. Marking a session done writes its session note, which counts toward Sessions left."
    },
    {
      "title": "Scores over time",
      "body": "Type each new PHQ-9 or GAD-7 score over the old one. The client's page keeps every score and shows them as a small chart."
    }
  ],
  "dashboardCards": [
    "today",
    "summary",
    "quotas",
    "missingInfo"
  ],
