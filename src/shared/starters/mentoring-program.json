{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "mentoring-program",
  "name": "Mentoring program",
  "description": "For mentoring programs: mentors and mentees, one-to-one matches, mentees on a board from referral to match, background checks and a match check-in every month.",
  "icon": "users",
  "group": "Faith and community",
  "vocab": {
    "record": {
      "one": "person",
      "many": "people",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true
  },
  "lists": [
    {
      "key": "mentors",
      "name": "Mentors",
      "description": "Volunteer mentors",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "mentor",
          "many": "mentors",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 200
        },
        {
          "name": "Interests",
          "column_type": "tag",
          "position": 3,
          "width": 140
        },
        {
          "name": "Background check",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last background check; due again every 2 years",
          "config": "{\"alert_rule_name\":\"Every 2 years\",\"log_changes\":true}"
        },
        {
          "name": "Training done",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date they finished mentor training"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 6,
          "width": 170,
          "config": "{\"options\":[\"Active\",\"Waiting for a match\",\"On a break\",\"Left\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 2 years",
          "description": "Due 2 years after the date entered",
          "interval_months": 24,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    },
    {
      "key": "mentees",
      "name": "Mentees",
      "description": "Young people waiting for or in a match",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "mentee",
          "many": "mentees",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 150
        },
        {
          "name": "Guardian",
          "column_type": "text",
          "position": 2,
          "width": 160
        },
        {
          "name": "Guardian phone",
          "column_type": "phone",
          "position": 3,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "School",
          "column_type": "text",
          "position": 4,
          "width": 170
        },
        {
          "name": "Interests",
          "column_type": "tag",
          "position": 5,
          "width": 140
        },
        {
          "name": "Referred on",
          "column_type": "date",
          "position": 6,
          "width": 150
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 7,
          "width": 130,
          "config": "{\"options\":[{\"label\":\"Referred\",\"color\":\"#64748b\"},{\"label\":\"Matching\",\"color\":\"#f59e0b\"},{\"label\":\"Matched\",\"color\":\"#22c55e\"},{\"label\":\"Closed\",\"color\":\"#ef4444\"}]}"
        },
        {
          "name": "Match date",
          "column_type": "date",
          "position": 8,
          "width": 150
        },
        {
          "name": "Last match check-in",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Date of the last check-in with the match; due monthly",
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Match check-in",
          "note_types": [
            "checkin"
          ],
          "per_month": 1
        }
      ],
      "links": [
        {
          "to": "mentors",
          "label_forward": "Matched with",
          "label_backward": "Mentee",
          "cardinality": "one_to_one"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "Referred",
            "color": "slate"
          },
          {
            "value": "Matching",
            "color": "amber"
          },
          {
            "value": "Matched",
            "color": "green"
          },
          {
            "value": "Closed",
            "color": "red",
            "done": true
          }
        ],
        "hideDoneAfterDays": 60
      }
    }
  ],
  "activityTypes": [
    {
      "key": "checkin",
      "label": "Match check-in",
      "icon": "🤝",
      "color": "green"
    }
  ],
