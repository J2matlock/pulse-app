    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": false,
    "measures": false,
    "appointments": false,
    "forms": false,
    "attachments": true
  },
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "call",
      "label": "Call",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "email",
      "label": "Email",
      "icon": "✉️",
      "color": "purple"
    },
    {
      "key": "certificate",
      "label": "Certificate received",
      "icon": "📄",
      "color": "green"
    }
  ],
  "documentTemplates": [
    {
      "name": "Certificate of insurance request",
      "content": "{{today}}\n\n{{name}}\nAttn: {{field:Contact person}}\n\nPlease send an updated certificate of insurance. Our records show your general liability coverage ends on {{field:General liability expires}} and your workers' comp coverage on {{field:Workers' comp expires}}.\n\nPlease have your agent list our company as certificate holder and additional insured. We can't schedule your crew on our sites until a current certificate is on file.\n\nThank you,\n\n{{my_name}}"
    },
    {
      "name": "Missing paperwork request",
      "content": "{{today}}\n\n{{name}}\nAttn: {{field:Contact person}}\n\nBefore your next job with us, we still need:\n\n- A completed W-9\n- Your signed subcontract agreement\n- A copy of your current contractor license\n\nYou can email them back or drop them off at the office.\n\nThank you,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Keep the certificates",
      "body": "Drop each certificate of insurance, W-9 and signed agreement into Files on the subcontractor's page. They are stored encrypted inside Pulse, and you can show them to your own insurance auditor."
    },
    {
      "title": "Before a job starts",
      "body": "Open the job to see every sub linked to it. Anything red on their page (an expired certificate, a missing W-9) should be sorted out before they start work."
    },
    {
      "title": "Additional insured",
      "body": "When you request a certificate, ask their agent to name your company as certificate holder and additional insured. The Certificate of insurance request letter already says so."
    }
  ],
  "lists": [
    {
      "key": "subcontractors",
      "name": "Subcontractors",
      "description": "The trades you hire, with their insurance certificates, licenses and paperwork",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "subcontractor",
          "many": "subcontractors",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Company",
          "column_type": "text",
          "position": 0,
          "width": 210,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Trade",
          "column_type": "dropdown",
          "position": 1,
          "width": 140,
          "config": "{\"options\": [\"Electrical\", \"Plumbing\", \"HVAC\", \"Roofing\", \"Concrete\", \"Framing\", \"Drywall\", \"Painting\", \"Excavation\", \"Flooring\", \"Other\"]}"
        },
        {
          "name": "Contact person",
          "column_type": "text",
          "position": 2,
          "width": 160
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 3,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 4,
          "width": 210
        },
        {
          "name": "General liability expires",
          "column_type": "date",
          "position": 5,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Expires (30-day warning)\", \"log_changes\": true}",
          "is_required": 1,
          "description": "From their certificate of insurance (COI)"
        },
        {
          "name": "Workers' comp expires",
          "column_type": "date",
          "position": 6,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Expires (30-day warning)\", \"log_changes\": true}",
          "description": "Leave blank and add a note if they have an exemption certificate"
        },
        {
          "name": "Auto liability expires",
          "column_type": "date",
          "position": 7,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Expires (30-day warning)\", \"log_changes\": true}",
          "description": "For subs who drive company vehicles to your sites"
        },
        {
          "name": "Contractor license expires",
          "column_type": "date",
          "position": 8,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Expires (30-day warning)\", \"log_changes\": true}",
          "description": "State or local contractor license"
        },
        {
          "name": "W-9 received",
          "column_type": "date",
          "position": 9,
          "width": 140,
          "is_required": 1,
          "description": "Date you got their W-9; empty shows as missing"
        },
        {
          "name": "Agreement signed",
          "column_type": "date",
          "position": 10,
          "width": 150,
          "is_required": 1,
          "description": "Date they signed your subcontract agreement; empty shows as missing"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 11,
          "width": 130,
          "config": "{\"options\": [\"Approved\", \"Waiting on paperwork\", \"On hold\", \"Do not use\"]}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 12,
          "width": 220
        }
      ],
      "alertRules": [
        {
          "name": "Expires (30-day warning)",
          "description": "The date entered is when it runs out; warns 30 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Renew soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 7, \"bgClass\": \"#f87171\", \"label\": \"Expiring\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Expires today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Expired\"}]"
        }
      ],
      "checklists": [
        {
          "name": "New sub onboarding",
          "description": "Before a new subcontractor sets foot on a site",
          "items": "[\"W-9 received\", \"Certificate of insurance received, with your company named as additional insured\", \"Workers' comp certificate, or an exemption certificate\", \"Contractor license looked up on the state website\", \"Subcontract agreement signed\", \"Safety training cards on file\", \"Emergency contact on file\"]"
        }
      ]
    },
    {
      "key": "jobs",
      "name": "Jobs",
      "description": "Projects and the subcontractors working on each one",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "job",
          "many": "jobs",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Job",
          "column_type": "text",
          "position": 0,
          "width": 230,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 1,
          "width": 190
        },
        {
          "name": "Property owner",
          "column_type": "text",
          "position": 2,
          "width": 170
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 3,
          "width": 130,
          "config": "{\"options\": [\"Bidding\", \"Signed\", \"Active\", \"Done\"]}"
        },
        {
          "name": "Start date",
          "column_type": "date",
          "position": 4,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Start date\", \"log_changes\": true}",
          "description": "Check every sub on the job has current paperwork before this date"
        },
        {
          "name": "Finish date",
          "column_type": "date",
          "position": 5,
          "width": 170,
          "config": "{\"alert_rule_name\": \"Finish date\", \"log_changes\": true}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 6,
          "width": 220
        }
      ],
      "alertRules": [
        {
          "name": "Start date",
          "description": "The date entered is the start of the job; hidden once the job is done",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Active\", \"Done\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Finish date",
          "description": "The date entered is when the job should be finished; hidden once it is done",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Done\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "links": [
        {
          "to": "subcontractors",
          "label_forward": "Subs on this job",
          "label_backward": "Jobs",
          "cardinality": "many_to_many"
        }
      ]
    }
  ],
  "dashboardCards": [
    "summary",
    "missingInfo",
    "recentActivity"
  ],
