{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "fleet-manager",
  "name": "Fleet manager",
  "description": "For small fleets: service every 5,000 miles or 6 months (Pulse estimates the date from each vehicle's mileage), registrations and annual inspections.",
  "icon": "truck",
  "group": "Trades and service",
  "keywords": [
    "truck",
    "van",
    "car",
    "vehicle",
    "maintenance"
  ],
  "vocab": {
    "record": {
      "one": "vehicle",
      "many": "vehicles",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "vehicles",
      "name": "Fleet",
      "description": "Vehicles with mileage-based service, registration and inspections",
      "kind": "thing",
      "columns": [
        {
          "name": "Unit",
          "column_type": "text",
          "position": 0,
          "width": 120,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Year",
          "column_type": "number",
          "position": 1,
          "width": 90
        },
        {
          "name": "Make and model",
          "column_type": "text",
          "position": 2,
          "width": 170
        },
        {
          "name": "Plate",
          "column_type": "text",
          "position": 3,
          "width": 110
        },
        {
          "name": "Odometer",
          "column_type": "number",
          "position": 4,
          "width": 120,
          "description": "Update it when you fuel up or service the vehicle"
        },
        {
          "name": "Odometer at last service",
          "column_type": "number",
          "position": 5,
          "width": 150
        },
        {
          "name": "Last service",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Service\",\"log_changes\":true}"
        },
        {
          "name": "Registration expires",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Annual inspection",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date of the last annual inspection",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Assigned driver",
          "column_type": "text",
          "position": 9,
          "width": 160
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 140,
          "config": "{\"options\":[\"In service\",\"In the shop\",\"Out of service\",\"Sold\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Service",
          "description": "Every 5,000 miles or 6 months, whichever comes first",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "meter",
          "rule_config": "{\"kind\":\"meter\",\"readingColumnId\":{\"column\":\"Odometer\"},\"lastServiceReadingColumnId\":{\"column\":\"Odometer at last service\"},\"every\":5000,\"unit\":\"mi\",\"timeFallback\":{\"months\":6},\"typicalPerDay\":60}"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "displayFormat": "{Unit} – {Year} {Make and model}"
    }
  ],
  "activityTypes": [
    {
      "key": "service",
      "label": "Service",
      "icon": "🔧",
      "color": "orange"
    },
    {
      "key": "fuel",
      "label": "Fuel",
      "icon": "⛽",
      "color": "blue"
    },
    {
      "key": "repair",
      "label": "Repair",
      "icon": "🛠️",
      "color": "red"
    }
  ],
