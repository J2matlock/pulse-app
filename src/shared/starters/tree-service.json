{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "tree-service",
  "name": "Tree service",
  "description": "For tree care companies: customers, jobs on a board from estimate request to done, estimate follow-ups, permits, equipment service by engine hours, aerial lift inspections and crew certifications.",
  "icon": "tree-deciduous",
  "group": "Trades and service",
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true,
    "measures": false,
    "appointments": true,
    "forms": true,
    "attachments": true
  },
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "call",
      "label": "Call",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "text",
      "label": "Text",
      "icon": "💬",
      "color": "teal"
    },
    {
      "key": "site_visit",
      "label": "Site visit",
      "icon": "🌳",
      "color": "green"
    }
  ],
  "documentTemplates": [
    {
      "name": "Estimate follow-up",
      "content": "{{today}}\n\nHi {{linked:Customer.Name}},\n\nI wanted to follow up on the estimate we sent on {{field:Estimate sent on}} for {{name}} ({{field:Estimate}}).\n\nLet me know if you have any questions, or if you would like to get on the schedule.\n\nThanks,\n\n{{my_name}}"
    },
    {
      "name": "Yearly tree check reminder",
      "content": "{{today}}\n\nHi {{name}},\n\nIt has been about a year since we last looked at your trees ({{field:Last tree check}}). A quick yearly check catches dead limbs, disease and storm damage before they turn into a bigger job.\n\nGive us a call to set up a free visit.\n\nThanks,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Estimates",
      "body": "Move a job to Estimate sent and Pulse fills in the date. If it is still waiting a week later, the Estimate follow-up column turns due. Once the job is approved (or not going ahead), the reminder goes away."
    },
    {
      "title": "Engine hours",
      "body": "Update the Hour meter on the chipper and grinder now and then. Pulse learns how fast the hours add up and shows about when the next service is due: every 100 hours or 6 months, whichever comes first."
    },
    {
      "title": "Before stump grinding",
      "body": "Call 811 a few days ahead so underground lines are marked, and keep the ticket number in a note on the job. The Job site safety checklist is added when a job moves to In progress."
    },
    {
      "title": "Photos and permits",
      "body": "Drop before-and-after photos, permits and signed estimates into Files on the job. They are stored encrypted inside Pulse."
    }
  ],
  "lists": [
    {
      "key": "customers",
      "name": "Customers",
      "description": "Homeowners, businesses and property managers you work for",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "customer",
          "many": "customers",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 200
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 3,
          "width": 180,
          "is_required": 1
        },
        {
          "name": "Preferred contact",
          "column_type": "dropdown",
          "position": 4,
          "width": 150,
          "config": "{\"options\": [\"Call\", \"Text\", \"Email\"]}"
        },
        {
          "name": "Property notes",
          "column_type": "notes",
          "position": 5,
          "width": 240,
          "description": "Gate code, dogs, power lines, where to park the chipper"
        },
        {
          "name": "Last tree check",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Date you last walked the property with them; Pulse reminds you a year later"
        },
        {
          "name": "Ash tree treatment",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 2 years\", \"log_changes\": true}",
          "description": "Last emerald ash borer injection. Leave blank if they have no ash trees"
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every 2 years",
          "description": "Due on the same date two years later",
          "interval_months": 24,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        }
      ]
    },
    {
      "key": "jobs",
      "name": "Jobs",
      "description": "Work from the first call to the cleanup check",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "job",
          "many": "jobs",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Job",
          "column_type": "text",
          "position": 0,
          "width": 230,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 1,
          "width": 160,
          "config": "{\"options\": [{\"label\": \"Estimate requested\", \"color\": \"#64748b\"}, {\"label\": \"Estimate sent\", \"color\": \"#3b82f6\"}, {\"label\": \"Approved\", \"color\": \"#8b5cf6\"}, {\"label\": \"Scheduled\", \"color\": \"#f59e0b\"}, {\"label\": \"In progress\", \"color\": \"#f97316\"}, {\"label\": \"Done\", \"color\": \"#22c55e\"}, {\"label\": \"Not going ahead\", \"color\": \"#ef4444\"}]}"
        },
        {
          "name": "Work type",
          "column_type": "dropdown",
          "position": 2,
          "width": 150,
          "config": "{\"options\": [\"Removal\", \"Pruning\", \"Stump grinding\", \"Storm cleanup\", \"Plant health care\", \"Cabling and bracing\", \"Inspection\"]}"
        },
        {
          "name": "Estimate",
          "column_type": "currency",
          "position": 3,
          "width": 120
        },
        {
          "name": "Estimate sent on",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Filled in when the job moves to Estimate sent"
        },
        {
          "name": "Estimate follow-up",
          "column_type": "date",
          "position": 5,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Estimate follow-up\", \"log_changes\": true}",
          "description": "Date you called back about the estimate"
        },
        {
          "name": "Scheduled for",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Scheduled date\", \"log_changes\": true}",
          "description": "The day the crew is booked"
        },
        {
          "name": "Permit expires",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Expires\", \"log_changes\": true}",
          "description": "Tree removal permit from the town, if one is needed"
        },
        {
          "name": "Completed on",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Filled in when the job moves to Done"
        },
        {
          "name": "Follow-up call",
          "column_type": "date",
          "position": 9,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Follow-up call\", \"log_changes\": true}",
          "description": "Date you checked the cleanup was OK and asked for a review"
        },
        {
          "name": "Invoice total",
          "column_type": "currency",
          "position": 10,
          "width": 130
        }
      ],
      "alertRules": [
        {
          "name": "Scheduled date",
          "description": "The date entered is the day of the job, until it is done",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is_not\", \"values\": [\"Done\", \"Not going ahead\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Expires",
          "description": "The date entered is when it runs out",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Estimate follow-up",
          "description": "Call back 7 days after sending an estimate, while it is still waiting",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Estimate sent on\"}, \"offset\": {\"days\": 7, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Estimate sent\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Follow-up call",
          "description": "Call the customer 7 days after the job is done",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Completed on\"}, \"offset\": {\"days\": 7, \"direction\": \"after\"}}"
        }
      ],
      "checklists": [
        {
          "name": "Job site safety",
          "description": "Before the first cut",
          "items": "[\"Walk the site and talk through the plan with the crew\", \"Power lines checked: stay 10 feet away unless line-clearance qualified\", \"Drop zone marked off with cones\", \"PPE checked: helmet, eye and ear protection, chaps\", \"Aerial rescue plan and first aid kit ready\", \"Nearest hospital noted\", \"Underground lines marked (811) before stump grinding\"]"
