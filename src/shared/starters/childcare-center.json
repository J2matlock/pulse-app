{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "childcare-center",
  "name": "Childcare director",
  "description": "For childcare centers: children with immunization records, physicals and emergency cards, and staff with CPR, background checks, TB tests and training hours.",
  "icon": "graduation-cap",
  "group": "Education and youth",
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "children",
      "name": "Children",
      "description": "Enrolled children with health forms and emergency cards",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "child",
          "many": "children",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Classroom",
          "column_type": "dropdown",
          "position": 2,
          "width": 130,
          "config": "{\"options\":[\"Infants\",\"Toddlers\",\"Preschool\",\"Pre-K\",\"School-age\"]}"
        },
        {
          "name": "Parent",
          "column_type": "text",
          "position": 3,
          "width": 160,
          "is_required": 1
        },
        {
          "name": "Parent phone",
          "column_type": "phone",
          "position": 4,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Allergies",
          "column_type": "text",
          "position": 5,
          "width": 160
        },
        {
          "name": "Start date",
          "column_type": "date",
          "position": 6,
          "width": 150
        },
        {
          "name": "Immunizations due",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "When the next immunization record is due",
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Physical exam",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date of the last physical exam form",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Emergency card updated",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    },
    {
      "key": "staff",
      "name": "Staff",
      "description": "Staff with certifications and checks",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "staff member",
          "many": "staff",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Role",
          "column_type": "dropdown",
          "position": 1,
          "width": 150,
          "config": "{\"options\":[\"Director\",\"Lead teacher\",\"Assistant teacher\",\"Cook\",\"Floater\"]}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140
        },
        {
          "name": "Hire date",
          "column_type": "date",
          "position": 3,
          "width": 150
        },
        {
          "name": "CPR/First aid expires",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Background check",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date of the last background check; due again every 5 years",
          "config": "{\"alert_rule_name\":\"Every 5 years\",\"log_changes\":true}"
        },
        {
          "name": "TB test",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Training hours this year",
          "column_type": "number",
          "position": 7,
          "width": 150
        }
      ],
      "alertRules": [
        {
          "name": "Expires (60-day warning)",
          "description": "The date entered is when it expires; warns 60, 30, 14 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":14,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every 5 years",
          "description": "Due 5 years after the date entered",
          "interval_months": 60,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "parent_contact",
      "label": "Parent contact",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "incident",
      "label": "Incident report",
      "icon": "🩹",
      "color": "red"
    }
  ],
  "documentTemplates": [
    {
      "name": "Health form reminder",
      "content": "{{today}}\n\nDear {{field:Parent}},\n\nOur records show {{name}}'s immunization record is due: {{deadline:Immunizations due}}.\n\nPlease bring an updated copy from the doctor's office so we can keep our files current.\n\nThank you,\n\n{{my_name}}"
    }
  ],
