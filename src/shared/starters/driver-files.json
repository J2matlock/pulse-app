{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "driver-files",
  "name": "Truck driver qualification files",
  "description": "Driver qualification files for a small fleet: CDL and medical card expiry, yearly MVR and driving record reviews, road tests and drug testing enrollment. Pulse is a tracking aid, not your official record system.",
  "icon": "truck",
  "group": "Trades and service",
  "keywords": [
    "dot",
    "cdl",
    "truck",
    "trucking",
    "driver qualification"
  ],
  "vocab": {
    "record": {
      "one": "driver",
      "many": "drivers",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "drivers",
      "name": "Driver files",
      "description": "Each driver's qualification file: license, medical card and yearly reviews",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "CDL expires",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Medical card expires",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "MVR review",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "description": "Date of the last motor vehicle record review; due again a year later",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Annual review",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last annual review of driving record",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "CDL class",
          "column_type": "dropdown",
          "position": 5,
          "width": 100,
          "is_required": 1,
          "config": "{\"options\":[\"A\",\"B\",\"C\"]}"
        },
        {
          "name": "CDL number",
          "column_type": "text",
          "position": 6,
          "width": 140
        },
        {
          "name": "Road test",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "Date of the road test (or the license accepted instead)"
        },
        {
          "name": "Drug testing enrolled",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date the driver joined the random testing pool"
        },
        {
          "name": "Hire date",
          "column_type": "date",
          "position": 9,
          "width": 150
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"On leave\",\"Former\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (60-day warning)",
          "description": "The date entered is when it expires; warns 60, 30, 14 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":14,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "document",
      "label": "Document received",
      "icon": "📄",
      "color": "green"
    }
  ],
  "documentTemplates": [
    {
      "name": "Medical card reminder",
      "content": "{{today}}\n\n{{name}},\n\nYour DOT medical card is due for renewal: {{deadline:Medical card expires}}.\n\nPlease book your exam and bring a copy of the new card to the office. You can't drive once it has expired.\n\nThank you,\n\n{{my_name}}"
    }
  ],
