{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "school-nurse",
  "name": "School nurse",
  "description": "Students with health needs: allergies, conditions, medication authorizations, health plan reviews and yearly vision and hearing screenings.",
  "icon": "stethoscope",
  "group": "Education and youth",
  "vocab": {
    "record": {
      "one": "student",
      "many": "students",
      "article": "a"
    },
    "list": {
      "one": "roster",
      "many": "rosters",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "students",
      "name": "Health roster",
      "description": "Students with health needs, screenings and medication authorizations",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Grade",
          "column_type": "dropdown",
          "position": 1,
          "width": 90,
          "config": "{\"options\":[\"K\",\"1\",\"2\",\"3\",\"4\",\"5\",\"6\",\"7\",\"8\"]}"
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Guardian",
          "column_type": "text",
          "position": 3,
          "width": 160
        },
        {
          "name": "Guardian phone",
          "column_type": "phone",
          "position": 4,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Allergies",
          "column_type": "text",
          "position": 5,
          "width": 160,
          "description": "Food, medicine or other allergies"
        },
        {
          "name": "Conditions",
          "column_type": "tag",
          "position": 6,
          "width": 140,
          "description": "Health conditions, e.g. asthma, diabetes"
        },
        {
          "name": "Immunizations complete",
          "column_type": "checkbox",
          "position": 7,
          "width": 130
        },
        {
          "name": "Medication authorization expires",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (30-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Health plan review",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Date of the last health plan review",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Vision screening",
          "column_type": "date",
          "position": 10,
          "width": 150,
          "description": "Date of the last vision screening",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Hearing screening",
          "column_type": "date",
          "position": 11,
          "width": 150,
          "description": "Date of the last hearing screening",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (30-day warning)",
          "description": "The date entered is when it expires; warns 30, 14, 7 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":7,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "office_visit",
      "label": "Office visit",
      "icon": "🩹",
      "color": "orange"
    },
    {
      "key": "medication",
      "label": "Medication given",
      "icon": "💊",
      "color": "purple"
    },
    {
      "key": "parent_call",
      "label": "Parent call",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    }
  ],
  "documentTemplates": [
    {
      "name": "Medication form reminder",
      "content": "{{today}}\n\nDear parent or guardian of {{name}},\n\nThe medication authorization on file at school is due for renewal: {{deadline:Medication authorization expires}}.\n\nPlease have the prescriber fill in a new form and return it to the health office so we can keep giving the medication at school.\n\nThank you,\n\n{{my_name}}\nSchool Nurse"
    }
  ],
