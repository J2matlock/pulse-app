{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "driving-school",
  "name": "Driving school",
  "description": "For driving schools and instructors: students from learner's permit to road test, practice and night hours, lessons left on a package, monthly parent updates, and instructor licenses, background checks and training cars. Hour and permit rules vary by state, so check yours. Pulse is a tracking aid, not your official record system.",
  "icon": "car-front",
  "group": "Education and youth",
  "keywords": [
    "driver ed",
    "student driver",
    "lessons"
  ],
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true,
    "measures": true,
    "appointments": true,
    "forms": true,
    "attachments": true
  },
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "lesson",
      "label": "Lesson",
      "icon": "🚗",
      "color": "blue"
    },
    {
      "key": "road_test",
      "label": "Road test",
      "icon": "🏁",
      "color": "green"
    },
    {
      "key": "parent_update",
      "label": "Parent update",
      "icon": "👪",
      "color": "teal"
    }
  ],
  "measures": [
    {
      "key": "driving_hours",
      "label": "Driving hours",
      "kind": "hours",
      "decimals": 1
    },
    {
      "key": "night_hours",
      "label": "Night hours",
      "kind": "hours",
      "decimals": 1
    }
  ],
  "documentTemplates": [
    {
      "name": "Road test reminder",
      "content": "{{today}}\n\nDear {{field:Parent / guardian}},\n\n{{name}}'s road test is on {{field:Road test date}}.\n\nPlease bring:\n- the learner's permit and photo ID\n- the signed practice log ({{field:Practice hours}} hours so far, {{field:Night hours}} at night)\n- the car's registration and insurance card, if {{name}} is testing in your car\n\nPlease arrive 20 minutes early. Good luck!\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Road test timing",
      "body": "Enter the date on the learner's permit. Pulse shows when the student can book the road test (6 months later) and turns it due until you fill in Road test booked. Many states use 6 months; change the rule in the column menu if yours is different."
    },
    {
      "title": "Practice hours",
      "body": "Update Practice hours and Night hours from the signed log; the number chart on the student's page shows their progress. You can also log hours on each lesson note (Driving hours, Night hours) and see totals in reports."
    },
    {
      "title": "Lesson packages",
      "body": "Lessons left counts Lesson notes between the enrollment date and the permit expiry, out of Lessons paid for. It warns when one lesson is left."
    },
    {
      "title": "Parent updates",
      "body": "Log a Parent update note once a month. The dashboard shows which families are still owed one this month."
    }
  ],
  "lists": [
    {
      "key": "students",
      "name": "Students",
      "description": "Learners from enrollment to their road test",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "student",
          "many": "students",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Permit expires",
          "column_type": "date",
          "position": 1,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Expires\", \"log_changes\": true}",
          "description": "When the learner's permit runs out"
        },
        {
          "name": "Road test booked",
          "column_type": "date",
          "position": 2,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Road test eligible\", \"log_changes\": true}",
          "description": "Date you booked the road test. Due once the permit is 6 months old"
        },
        {
          "name": "Road test date",
          "column_type": "date",
          "position": 3,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Test day\", \"log_changes\": true}",
          "description": "The day of the road test"
        },
        {
          "name": "Lessons left",
          "column_type": "deadline",
          "position": 4,
          "width": 140,
          "config": "{\"alert_rule_name\": \"Lessons left\"}"
        },
        {
          "name": "Status",
          "column_type": "status",
          "position": 5,
          "width": 170,
          "config": "{\"options\": [{\"label\": \"Enrolled\", \"color\": \"#64748b\"}, {\"label\": \"Learning\", \"color\": \"#3b82f6\"}, {\"label\": \"Ready for road test\", \"color\": \"#f59e0b\"}, {\"label\": \"Passed\", \"color\": \"#22c55e\"}, {\"label\": \"Withdrawn\", \"color\": \"#ef4444\"}]}"
        },
        {
          "name": "Parent / guardian",
          "column_type": "text",
          "position": 6,
          "width": 170,
          "is_required": 1
        },
        {
          "name": "Parent phone",
          "column_type": "phone",
          "position": 7,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Permit issued",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "is_required": 1,
          "description": "Date on the learner's permit; the road test date is worked out from it"
        },
        {
          "name": "Passed on",
          "column_type": "date",
          "position": 9,
          "width": 140,
          "description": "Filled in when the student moves to Passed"
        },
        {
          "name": "Practice hours",
          "column_type": "number",
          "position": 10,
          "width": 130,
          "description": "Supervised driving hours so far, from the practice log (most states ask for 50)"
        },
        {
          "name": "Night hours",
          "column_type": "number",
          "position": 11,
          "width": 120,
          "description": "Of those, hours driven after dark (most states ask for 10)"
        },
        {
          "name": "Enrolled on",
          "column_type": "date",
          "position": 12,
          "width": 140,
          "description": "Lessons are counted from this date until the permit expires"
        },
        {
          "name": "Lessons paid for",
          "column_type": "number",
          "position": 13,
          "width": 140
        }
      ],
      "alertRules": [
        {
          "name": "Road test eligible",
          "description": "Book the road test once the permit is 6 months old",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Permit issued\"}, \"offset\": {\"months\": 6, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Passed\", \"Withdrawn\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Test day",
          "description": "The date entered is the day of the road test, until the student passes",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Passed\", \"Withdrawn\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Expires",
          "description": "The date entered is when it runs out",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Passed\", \"Withdrawn\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Lessons left",
          "description": "Counts lessons between the enrollment date and the permit expiry",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\": \"quota\", \"activityTypes\": [\"lesson\"], \"limitColumnId\": {\"column\": \"Lessons paid for\"}, \"startColumnId\": {\"column\": \"Enrolled on\"}, \"endColumnId\": {\"column\": \"Permit expires\"}, \"warnRemaining\": 1, \"warnDaysBeforeEnd\": 30}",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is_not\", \"values\": [\"Passed\", \"Withdrawn\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "requirements": [
        {
          "label": "Parent update",
          "note_types": [
            "parent_update"
          ],
          "per_month": 1,
          "period": "month"
        }
