{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "community-health-worker",
  "name": "Community health worker",
  "description": "Outreach and follow-up for community health workers: two contacts a month, screenings due, health concerns and referrals.",
  "icon": "heart-pulse",
  "group": "Human services",
  "keywords": [
    "chw",
    "outreach",
    "medicaid",
    "health"
  ],
  "vocab": {
    "record": {
      "one": "client",
      "many": "clients",
      "article": "a"
    },
    "list": {
      "one": "caseload",
      "many": "caseloads",
      "article": "a"
    },
    "activity": {
      "one": "case note",
      "many": "case notes",
      "article": "a"
    },
    "activityLog": {
      "one": "case log",
      "many": "case logs",
      "article": "a"
    },
    "contactDirectory": {
      "one": "contacts",
      "many": "contacts",
      "article": "a",
      "oneCap": "Contacts",
      "manyCap": "Contacts"
    },
    "contact": {
      "one": "provider",
      "many": "providers",
      "article": "a"
    },
    "priority": {
      "one": "acuity level",
      "many": "acuity levels",
      "article": "an"
    },
    "archive": {
      "one": "archive",
      "many": "archives",
      "article": "an"
    },
    "worker": {
      "one": "case manager",
      "many": "case managers",
      "article": "a"
    },
    "requirement": {
      "one": "contact requirement",
      "many": "contact requirements",
      "article": "a"
    },
    "appointment": {
      "one": "appointment",
      "many": "appointments",
      "article": "an"
    },
    "stage": {
      "one": "stage",
      "many": "stages",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": true,
    "contactsDirectory": true,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true
  },
  "lists": [
    {
      "key": "caseload",
      "name": "Community health caseload",
      "description": "People you support with outreach, screenings and referrals",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Preferred language",
          "column_type": "dropdown",
          "position": 2,
          "width": 150,
          "config": "{\"options\":[\"English\",\"Spanish\",\"Vietnamese\",\"Arabic\",\"Other\"]}"
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 3,
          "width": 160
        },
        {
          "name": "Health concerns",
          "column_type": "tag",
          "position": 4,
          "width": 140
        },
        {
          "name": "Last contact",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Screening due",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "The next screening (blood pressure, A1C, mammogram…)",
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Primary care clinic",
          "column_type": "text",
          "position": 7,
          "width": 160
        },
        {
          "name": "Insurance",
          "column_type": "dropdown",
          "position": 8,
          "width": 130,
          "config": "{\"options\":[\"Medicaid\",\"Medicare\",\"Marketplace\",\"None\"]}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"Outreach\",\"Closed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Contacts",
          "note_types": [
            "visit",
            "phone",
            "text"
          ],
          "per_month": 2
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "text",
      "label": "Text",
      "icon": "💬",
      "color": "teal"
    },
    {
      "key": "referral",
      "label": "Referral made",
      "icon": "➡️",
      "color": "amber"
    }
  ],
