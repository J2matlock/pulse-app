  "documentTemplates": [
    {
      "name": "Vaccines coming up",
      "content": "{{today}}\n\nHi {{linked:Owner.Name}},\n\n{{name}} is due for spring or fall shots: {{deadline:Last vaccines}}.\n\nThe vet is coming out soon, so let us know if you'd like {{name}} added to the list, or if your own vet will handle it.\n\nThanks,\n\n{{my_name}}"
    },
    {
      "name": "Coggins due",
      "content": "{{today}}\n\nHi {{linked:Owner.Name}},\n\n{{name}}'s Coggins test is coming due: {{deadline:Coggins test}}. We need a current negative Coggins on file for every horse in the barn.\n\nWe can have it drawn at the next vet visit, or you can drop off a copy from your own vet.\n\nThanks,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Farrier and shots",
      "body": "Fill in the date of each farrier visit, deworming, Coggins and set of shots. Pulse works out when the next one is due and colors it as it gets close."
    },
    {
      "title": "Breeding",
      "body": "Set a mare's Breeding status to Bred and enter the breeding date. The pregnancy check comes due about 15 days later and foaling about 340 days later. Change it to In foal once she's confirmed, and to Foaled when the foal arrives: the reminders go away on their own."
    },
    {
      "title": "Papers",
      "body": "Drop Coggins certificates, vaccine records and boarding agreements into Files on the horse or owner. They are stored encrypted inside Pulse."
    }
  ],
  "lists": [
    {
      "key": "horses",
      "name": "Horses",
      "description": "Every horse in the barn, with hoof care, health and breeding dates",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "horse",
          "many": "horses",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 170,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Last farrier visit",
          "column_type": "date",
          "position": 1,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 7 weeks\", \"log_changes\": true}",
          "description": "Trim or shoes; the next visit comes due 7 weeks later"
        },
        {
          "name": "Last deworming",
          "column_type": "date",
          "position": 2,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 12 weeks\", \"log_changes\": true}"
        },
        {
          "name": "Coggins test",
          "column_type": "date",
          "position": 3,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Date the last negative Coggins was drawn; most shows and barns want one within 12 months"
        },
        {
          "name": "Last vaccines",
          "column_type": "date",
          "position": 4,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 6 months\", \"log_changes\": true}",
          "description": "Spring and fall shots"
        },
        {
          "name": "Teeth floated",
          "column_type": "date",
          "position": 5,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Last dental visit"
        },
        {
          "name": "Pregnancy check",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Pregnancy check\", \"log_changes\": true}",
          "description": "Date of the ultrasound check, about 15 days after breeding"
        },
        {
          "name": "Foaled on",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Foaling due\", \"log_changes\": true}",
          "description": "Foaling is due about 340 days after breeding; fill this in when the foal arrives"
        },
        {
          "name": "Breed",
          "column_type": "text",
          "position": 8,
          "width": 150
        },
        {
          "name": "Born",
          "column_type": "date",
          "position": 9,
          "width": 130,
          "description": "Year or date of birth, if known"
        },
        {
          "name": "Stall",
          "column_type": "text",
          "position": 10,
          "width": 100,
          "description": "Stall or pasture"
        },
        {
          "name": "Breeding status",
          "column_type": "dropdown",
          "position": 11,
          "width": 150,
          "config": "{\"options\": [\"Open\", \"Bred\", \"In foal\", \"Foaled\"]}",
          "description": "For mares; leave blank for geldings and stallions"
        },
        {
          "name": "Breeding date",
          "column_type": "date",
          "position": 12,
          "width": 150,
          "description": "Last cover or insemination date"
        }
      ],
      "alertRules": [
        {
          "name": "Every 7 weeks",
          "description": "Due 49 days after the date entered",
          "interval_days": 49,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every 12 weeks",
          "description": "Due 84 days after the date entered",
          "interval_days": 84,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Pregnancy check",
          "description": "Ultrasound 15 days after breeding, while the mare is marked Bred",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Breeding date\"}, \"offset\": {\"days\": 15, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Breeding status\"}, \"op\": \"is\", \"values\": [\"Bred\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Foaling due",
          "description": "About 340 days after breeding, while the mare is Bred or In foal",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Breeding date\"}, \"offset\": {\"days\": 340, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Breeding status\"}, \"op\": \"is\", \"values\": [\"Bred\", \"In foal\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "checklists": [
        {
          "name": "New horse arriving",
          "description": "Before a new boarder moves in",
