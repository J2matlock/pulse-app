{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "home-health-nursing",
  "name": "Home health nursing",
  "description": "For home health nurses and nurse case managers: a visit every week, recertifications, plan-of-care signatures, visits on the calendar, and minutes and miles on every visit note for your mileage claim. Pulse is a tracking aid, not your official record system.",
  "icon": "stethoscope",
  "group": "Health",
  "keywords": [
    "home health",
    "nurse",
    "nursing",
    "rn",
    "lpn",
    "patient",
    "visits",
    "hospice",
    "skilled nursing",
    "recertification",
    "oasis",
    "mileage"
  ],
