  "helpTips": [
    {
      "title": "Minutes and miles",
      "body": "Type the minutes and miles in the boxes under each visit note. Miles and minutes this month, on the dashboard and in Reports, adds them up for your mileage claim and timesheet."
    },
    {
      "title": "Last visit moves on its own",
      "body": "Logging a Visit note fills in Last visit, so the 7-day reminder starts again without typing the date twice."
    },
    {
      "title": "Recertifications",
      "body": "Put the end of each 60-day episode in Recertification due. It turns yellow 14 days ahead, so there's time for the recertification visit and the paperwork."
    }
  ],
  "lists": [
    {
      "key": "patients",
      "name": "Patients",
      "description": "Patients with weekly visits, recertifications and plan-of-care signatures",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Last visit",
          "column_type": "date",
          "position": 1,
          "width": 130,
          "description": "Date of the last visit. Logging a Visit note fills it in; the next one is due 7 days later",
          "config": "{\"note_updates\": [\"visit\"], \"alert_rule_name\": \"Every 7 days\", \"log_changes\": true}"
        },
        {
          "name": "Next visit",
          "column_type": "date",
          "position": 2,
          "width": 130,
          "description": "Date of the next scheduled visit",
          "config": "{\"alert_rule_name\": \"Due date\", \"log_changes\": true}"
        },
        {
          "name": "Recertification due",
          "column_type": "date",
          "position": 3,
          "width": 170,
          "description": "End of this 60-day episode: recertify by this date",
          "config": "{\"alert_rule_name\": \"Due date\", \"log_changes\": true}"
        },
        {
          "name": "Plan of care signed",
          "column_type": "date",
          "position": 4,
          "width": 170,
          "description": "Date the physician signed the plan of care; due again 60 days later",
          "config": "{\"alert_rule_name\": \"Every 60 days\", \"log_changes\": true}"
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 5,
          "width": 130
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 6,
          "width": 130,
          "is_required": 1
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 7,
          "width": 200
        },
        {
          "name": "Physician",
          "column_type": "text",
          "position": 8,
          "width": 160
        },
        {
          "name": "Physician phone",
          "column_type": "phone",
          "position": 9,
          "width": 140
        },
        {
          "name": "Insurance",
          "column_type": "text",
          "position": 10,
          "width": 140
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 11,
          "width": 140,
          "config": "{\"options\": [\"Active\", \"On hold\", \"Transitioning\", \"Discharged\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 7 days",
          "description": "Due 7 days after the last visit",
          "interval_days": 7,
          "thresholds": "[{\"daysBefore\":2,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":1,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 60 days",
          "description": "Due 60 days after the date entered",
          "interval_days": 60,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "dashboardCards": [
    "today",
    "summary",
    "missingInfo"
  ],
