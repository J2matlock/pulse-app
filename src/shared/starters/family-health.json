  "helpTips": [
    {
      "title": "Checkups by age",
      "body": "Enter each child's date of birth and Pulse shows their next well-child checkup. After the visit, mark it done and the next one appears. From age 3 it's once a year. Your doctor's schedule wins if it differs."
    },
    {
      "title": "Private by design",
      "body": "Your family's health details stay on this computer, encrypted with your password. Nothing goes to the cloud, and Pulse locks itself when you step away."
    },
    {
      "title": "Vaccine records and insurance cards",
      "body": "Drop a photo or PDF of vaccine records, insurance cards and test results into Files on each person's page. They're stored encrypted inside Pulse, ready when a school or camp asks."
    },
    {
      "title": "Flu shots",
      "body": "Each fall the Flu shot column comes due by the end of October. Mark it done when everyone has had theirs."
    }
  ],
  "lists": [
    {
      "key": "family",
      "name": "Family",
      "description": "Everyone in the household, with checkups, cleanings and refills due",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "family member",
          "many": "family members",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Checkups",
          "column_type": "deadline",
          "position": 1,
          "width": 150,
          "description": "The next well-child checkup; mark it done to move on",
          "config": "{\"alert_rule_name\": \"Well-child checkups\"}"
        },
        {
          "name": "Last physical",
          "column_type": "date",
          "position": 2,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Yearly physical\", \"log_changes\": true}",
          "description": "For adults: date of the last yearly physical"
        },
        {
          "name": "Last dental cleaning",
          "column_type": "date",
          "position": 3,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 6 months\", \"log_changes\": true}"
        },
        {
          "name": "Last eye exam",
          "column_type": "date",
          "position": 4,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}"
        },
        {
          "name": "Flu shot",
          "column_type": "deadline",
          "position": 5,
          "width": 150,
          "description": "This season's flu shot; mark it done when they've had it",
          "config": "{\"alert_rule_name\": \"Flu shot\"}"
        },
        {
          "name": "Next refill",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Due date\", \"log_changes\": true}",
          "description": "When the next prescription refill is needed"
        },
        {
          "name": "Insurance renews",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Renewal\", \"log_changes\": true}",
          "description": "Health or dental plan renewal, or when the card expires"
        },
        {
          "name": "Who",
          "column_type": "dropdown",
          "position": 8,
          "width": 110,
          "is_required": 1,
          "description": "Child or adult: decides which checkups apply",
          "config": "{\"options\": [\"Child\", \"Adult\"]}"
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Children's checkups count from here"
        },
        {
          "name": "Allergies",
          "column_type": "notes",
          "position": 10,
          "width": 180
        },
        {
          "name": "Medications",
          "column_type": "notes",
          "position": 11,
          "width": 200,
          "description": "Name, dose and how often"
        }
      ],
      "alertRules": [
        {
          "name": "Well-child checkups",
          "description": "Checkups by age, counted from the date of birth: 1, 2, 4, 6, 9, 12, 15, 18 months, 2 years, 30 months, then every year",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "sequence",
          "rule_config": "{\"kind\": \"sequence\", \"anchorColumnId\": {\"column\": \"Date of birth\"}, \"steps\": [{\"label\": \"1 month\", \"offset\": {\"months\": 1}}, {\"label\": \"2 months\", \"offset\": {\"months\": 2}}, {\"label\": \"4 months\", \"offset\": {\"months\": 4}}, {\"label\": \"6 months\", \"offset\": {\"months\": 6}}, {\"label\": \"9 months\", \"offset\": {\"months\": 9}}, {\"label\": \"12 months\", \"offset\": {\"months\": 12}}, {\"label\": \"15 months\", \"offset\": {\"months\": 15}}, {\"label\": \"18 months\", \"offset\": {\"months\": 18}}, {\"label\": \"2 years\", \"offset\": {\"months\": 24}}, {\"label\": \"30 months\", \"offset\": {\"months\": 30}}, {\"label\": \"Yearly checkup\", \"offset\": {\"months\": 36}}], \"repeatLast\": {\"months\": 12}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Who\"}, \"op\": \"is\", \"values\": [\"Child\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Yearly physical",
          "description": "Due a year after the last physical (adults)",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 45, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 21, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Who\"}, \"op\": \"is\", \"values\": [\"Adult\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 45, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 21, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Flu shot",
          "description": "Every fall, by the end of October",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\": \"calendar\", \"months\": [10], \"day\": \"last\", \"lead\": 45}"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Renewal",
          "description": "The date entered is when it renews or runs out",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        }
      ],
