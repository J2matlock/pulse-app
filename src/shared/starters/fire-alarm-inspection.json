{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "fire-alarm-inspection",
  "name": "Fire & alarm inspection",
  "description": "For fire protection and alarm companies: customers, their sites and every device at each site, with yearly inspections and 5-year hydrostatic tests on extinguishers, and inspection certificates kept with each site.",
  "icon": "shield-check",
  "group": "Property and safety",
  "keywords": [
    "fire",
    "sprinkler",
    "extinguisher",
    "inspection"
  ],
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "attachments": true
  },
  "lists": [
    {
      "key": "customers",
      "name": "Customers",
      "description": "Businesses and building owners you inspect for",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "customer",
          "many": "customers",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Customer",
          "column_type": "text",
          "position": 0,
          "width": 210,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Contact person",
          "column_type": "text",
          "position": 1,
          "width": 160
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 3,
          "width": 200
        },
        {
          "name": "Billing address",
          "column_type": "address",
          "position": 4,
          "width": 160
        },
        {
          "name": "Contract",
          "column_type": "dropdown",
          "position": 5,
          "width": 140,
          "config": "{\"options\":[\"Annual\",\"Semi-annual\",\"Quarterly\",\"Call-out only\"]}"
        }
      ]
    },
    {
      "key": "sites",
      "name": "Sites",
      "description": "Buildings and locations",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "site",
          "many": "sites",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Site",
          "column_type": "text",
          "position": 0,
          "width": 210,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 1,
          "width": 160,
          "is_required": 1
        },
        {
          "name": "Monitoring account",
          "column_type": "text",
          "position": 2,
          "width": 160
        },
        {
          "name": "Last inspection",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "description": "Date of the last full inspection",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Access notes",
          "column_type": "notes",
          "position": 4,
          "width": 220,
          "description": "Keys, codes, who to ask for"
        },
        {
          "name": "Certificates",
          "column_type": "file_count",
          "position": 5,
          "width": 130,
          "description": "How many inspection certificates and reports are in Files on the site's page"
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "customers",
          "label_forward": "Customer",
          "label_backward": "Sites",
          "cardinality": "many_to_one"
        }
      ]
    },
    {
      "key": "devices",
      "name": "Devices",
      "description": "Extinguishers, detectors, panels and systems at each site",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "device",
          "many": "devices",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Device",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Type",
          "column_type": "dropdown",
          "position": 1,
          "width": 170,
          "config": "{\"options\":[\"Fire extinguisher\",\"Smoke detector\",\"Sprinkler system\",\"Alarm panel\",\"Emergency light\",\"Kitchen hood system\"]}"
        },
        {
          "name": "Location",
          "column_type": "text",
          "position": 2,
          "width": 170
        },
        {
          "name": "Serial number",
          "column_type": "text",
          "position": 3,
          "width": 150
        },
        {
          "name": "Installed",
          "column_type": "date",
          "position": 4,
          "width": 150
        },
        {
          "name": "Last inspection",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date of the last inspection or service",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Hydrostatic test",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "Extinguishers: date of the last hydrostatic test; due every 5 years",
          "config": "{\"alert_rule_name\":\"Every 5 years\",\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 7,
          "width": 130,
          "config": "{\"options\":[\"OK\",\"Needs repair\",\"Replaced\",\"Removed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 5 years",
          "description": "Due 5 years after the date entered",
          "interval_months": 60,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "sites",
          "label_forward": "Site",
          "label_backward": "Devices",
          "cardinality": "many_to_one"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "inspection",
      "label": "Inspection",
      "icon": "🔍",
      "color": "orange"
    },
    {
      "key": "repair",
      "label": "Repair",
      "icon": "🛠️",
      "color": "red"
    }
  ],
  "documentTemplates": [
    {
      "name": "Inspection due notice",
      "content": "{{today}}\n\n{{linked:Customer.Contact person}},\n\nThe yearly fire and life safety inspection at {{name}} is coming due: {{deadline:Last inspection}}.\n\nPlease call us to schedule a visit.\n\nThank you,\n\n{{my_name}}"
    }
  ],
