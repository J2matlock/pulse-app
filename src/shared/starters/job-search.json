{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "job-search",
  "name": "Job search",
  "description": "For anyone looking for work: applications on a board from interested to an answer, follow-ups a week after applying, thank-you notes after interviews, offer deadlines, and the people who can help.",
  "icon": "briefcase",
  "group": "Personal",
  "keywords": [
    "job",
    "resume",
    "interview",
    "application",
    "career"
  ],
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": false,
    "handoff": false,
    "links": true,
    "stages": true,
    "measures": false,
    "appointments": true,
    "forms": false,
    "attachments": true
  },
