      "icon": "🤝",
      "color": "purple"
    }
  ],
  "documentTemplates": [
    {
      "name": "Follow-up on my application",
      "content": "Hello,\n\nI applied for the {{name}} position on {{field:Applied on}} and wanted to follow up. I am still very interested in the role and would be glad to share anything else that would help.\n\nThank you for your time,\n\n{{my_name}}"
    },
    {
      "name": "Thank-you after an interview",
      "content": "Hello,\n\nThank you for taking the time to talk with me about the {{name}} position. I enjoyed learning more about the team at {{linked:Company.Name}}, and I am excited about the chance to work with you.\n\nPlease let me know if there is anything else I can send.\n\nBest regards,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "The board",
      "body": "Drag an application across the board as it moves. Moving it to Applied fills in the date, and a follow-up comes due a week later if you have not heard back. Moving it to Interviewing adds the Before the interview checklist."
    },
    {
      "title": "Thank-you notes",
      "body": "After an interview, put the date in Last interview. A thank-you note comes due the next day. The Thank-you after an interview letter fills in the job and company for you."
    },
    {
      "title": "Interviews on the calendar",
      "body": "Add each interview as an appointment on the application, so the dashboard shows what is coming up today and this week."
    },
    {
      "title": "Your resume and cover letters",
      "body": "Drop the resume and cover letter you sent into Files on the application, so you always know which version they have."
    }
  ],
  "lists": [
    {
      "key": "applications",
      "name": "Applications",
      "description": "Every job you are looking at, from interested to an answer",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "application",
          "many": "applications",
          "article": "an"
        }
      },
      "columns": [
        {
          "name": "Job",
          "column_type": "text",
          "position": 0,
          "width": 220,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1,
          "description": "The job title"
        },
        {
          "name": "Apply by",
          "column_type": "date",
          "position": 1,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Apply by\", \"log_changes\": true}",
          "description": "Closing date on the posting"
        },
        {
          "name": "Follow-up sent",
          "column_type": "date",
          "position": 2,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Follow-up\", \"log_changes\": true}",
          "description": "Date you checked in about your application"
        },
        {
          "name": "Thank-you sent",
          "column_type": "date",
          "position": 3,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Thank-you note\", \"log_changes\": true}",
          "description": "Date you sent a thank-you after the interview"
        },
        {
          "name": "Respond to offer by",
          "column_type": "date",
          "position": 4,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Respond by\", \"log_changes\": true}",
          "description": "When they need your answer"
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 5,
          "width": 150,
          "config": "{\"options\": [{\"label\": \"Interested\", \"color\": \"#64748b\"}, {\"label\": \"Applied\", \"color\": \"#3b82f6\"}, {\"label\": \"Interviewing\", \"color\": \"#8b5cf6\"}, {\"label\": \"Offer\", \"color\": \"#f59e0b\"}, {\"label\": \"Accepted\", \"color\": \"#22c55e\"}, {\"label\": \"Not this time\", \"color\": \"#ef4444\"}]}"
        },
        {
          "name": "Found on",
          "column_type": "dropdown",
          "position": 6,
          "width": 140,
          "config": "{\"options\": [\"Job board\", \"Company website\", \"Referral\", \"Recruiter\", \"Networking\", \"Job fair\"]}"
        },
        {
          "name": "Pay",
          "column_type": "text",
          "position": 7,
          "width": 130,
          "description": "What the posting says, e.g. $22/hour or $52–58k"
        },
        {
          "name": "Posting link",
          "column_type": "url",
          "position": 8,
          "width": 180
        },
        {
          "name": "Applied on",
          "column_type": "date",
          "position": 9,
          "width": 140,
          "description": "Filled in when the application moves to Applied"
        },
        {
          "name": "Last interview",
          "column_type": "date",
          "position": 10,
          "width": 150,
          "description": "Date of your most recent interview for this job"
        },
        {
          "name": "Closed on",
          "column_type": "date",
          "position": 11,
          "width": 140,
          "description": "Filled in when the application moves to Accepted or Not this time"
        }
      ],
      "alertRules": [
        {
          "name": "Apply by",
          "description": "The closing date for applications, until you apply",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Interested\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Follow-up",
          "description": "Check in 7 days after applying, while you are still waiting to hear",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 2, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 1, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Applied on\"}, \"offset\": {\"days\": 7, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Applied\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Thank-you note",
          "description": "Send a thank-you the day after an interview",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 2, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 1, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Last interview\"}, \"offset\": {\"days\": 1, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Interviewing\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Respond by",
          "description": "The date they need your answer on an offer",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 2, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 1, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Offer\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "checklists": [
        {
          "name": "Before the interview",
          "description": "The day before",
          "items": "[\"Read the job posting again\", \"Look up the company and the people you will meet\", \"Practice telling your story in two minutes\", \"Write down three questions to ask them\", \"Print copies of your resume\", \"Plan the route or test the video link\", \"Lay out what you will wear\"]"
        }
      ],
      "links": [
        {
          "to": "companies",
          "label_forward": "Company",
          "label_backward": "Applications",
          "cardinality": "many_to_one"
        }
      ],
