{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "business-licenses",
  "name": "Business licenses and permits",
  "description": "Track every license, permit and registration your business holds, with warnings 90, 60, 30 and 7 days before each expires and a renewal checklist.",
  "icon": "file-badge",
  "group": "Business",
  "vocab": {
    "record": {
      "one": "license",
      "many": "licenses",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "licenses",
      "name": "Licenses & permits",
      "description": "Every license, permit and registration, with its expiry date",
      "kind": "thing",
      "columns": [
        {
          "name": "License or permit",
          "column_type": "text",
          "position": 0,
          "width": 220,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Issued by",
          "column_type": "text",
          "position": 1,
          "width": 200,
          "description": "The agency or office that issues it"
        },
        {
          "name": "Number",
          "column_type": "text",
          "position": 2,
          "width": 160
        },
        {
          "name": "Location",
          "column_type": "text",
          "position": 3,
          "width": 160,
          "description": "The site or location it covers"
        },
        {
          "name": "Issued on",
          "column_type": "date",
          "position": 4,
          "width": 150
        },
        {
          "name": "Expires on",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true,\"done_checklist_name\":\"Renewal steps\"}"
        },
        {
          "name": "Renewal fee",
          "column_type": "currency",
          "position": 6,
          "width": 120
        },
        {
          "name": "Renewal steps",
          "column_type": "notes",
          "position": 7,
          "width": 220,
          "description": "Anything special about renewing this one"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 8,
          "width": 130,
          "config": "{\"options\":[\"Current\",\"Renewal sent\",\"Expired\",\"Not needed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (90-day warning)",
          "description": "The date entered is when it expires; warns 90, 60, 30, 7 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":90,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":7,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        }
      ],
      "checklists": [
        {
          "name": "Renewal steps",
          "description": "What to do each time a license or permit is renewed",
          "items": "[\"Fill in the renewal form\",\"Pay the fee\",\"File a copy of the new license\",\"Update the expiry date\"]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "application",
      "label": "Application sent",
      "icon": "📨",
      "color": "blue"
    },
    {
      "key": "payment",
      "label": "Payment made",
      "icon": "💳",
      "color": "green"
    },
    {
      "key": "inspection",
      "label": "Inspection",
      "icon": "🔍",
      "color": "orange"
    }
  ],
