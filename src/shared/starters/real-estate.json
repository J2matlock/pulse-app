{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "real-estate",
  "name": "Real estate transactions",
  "description": "For real estate agents: buyers and sellers, and each home on a board from showing to closing, with the inspection, appraisal, financing and closing dates counted from the contract date, pre-approval and listing expirations, and a note on every closing anniversary. Your contract sets the real dates. Pulse is a tracking aid, not your official record system.",
  "icon": "handshake",
  "group": "Business",
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true,
    "measures": false,
    "appointments": true,
    "forms": false,
    "attachments": true
  },
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "call",
      "label": "Call",
      "icon": "📞",
      "color": "blue"
    },
    {
      "key": "text",
      "label": "Text",
      "icon": "💬",
      "color": "teal"
    },
    {
      "key": "showing",
      "label": "Showing",
      "icon": "🏠",
      "color": "green"
    }
  ],
  "documentTemplates": [
    {
      "name": "Under contract: key dates",
      "content": "{{today}}\n\nHi {{linked:Client.Name}},\n\nCongratulations, {{name}} is under contract! Here are the dates we are working toward:\n\n- Inspection: {{deadline:Inspection done}}\n- Appraisal: {{deadline:Appraisal received}}\n- Loan approval: {{deadline:Loan approved}}\n- Closing: {{field:Closing date}}\n\nI will keep you posted at every step. Call me any time with questions.\n\n{{my_name}}"
    },
    {
      "name": "Closing anniversary note",
      "content": "{{today}}\n\nHi {{linked:Client.Name}},\n\nHard to believe it has been a year since you closed on {{name}} ({{field:Closed on}}). I hope the place feels like home.\n\nIf you ever have questions about your home's value, or know someone thinking of buying or selling, I would love to help.\n\nWarmly,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Dates from the contract",
      "body": "Fill in the Contract date and Pulse counts the inspection (10 days), appraisal and financing (21 days) from it. Change the days under the column's deadline settings to match your contract. Fill in each date when it is done."
    },
    {
      "title": "After closing",
      "body": "Move a transaction to Closed and Pulse fills in Closed on. The contingency dates go away, and the closing anniversary comes up a month ahead every year, a good time to send the anniversary note."
    },
    {
      "title": "Keep the paperwork",
      "body": "Drop the signed contract, inspection report and closing disclosure into Files on the transaction. They are stored encrypted inside Pulse."
    }
  ],
  "lists": [
    {
      "key": "clients",
      "name": "Buyers & sellers",
      "description": "The people you are helping buy or sell a home",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "client",
          "many": "clients",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 210
        },
        {
          "name": "Buying or selling",
          "column_type": "dropdown",
          "position": 3,
          "width": 160,
          "config": "{\"options\": [\"Buying\", \"Selling\", \"Both\"]}"
        },
        {
          "name": "Current address",
          "column_type": "address",
          "position": 4,
          "width": 180
        },
        {
          "name": "Price range",
          "column_type": "text",
          "position": 5,
          "width": 140,
          "description": "What they want to spend, or what they hope to get"
        },
        {
          "name": "Pre-approval expires",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Expires\", \"log_changes\": true}",
          "description": "Mortgage pre-approval letters usually run 60 to 90 days"
        },
        {
          "name": "Listing agreement expires",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Expires\", \"log_changes\": true}",
          "description": "For sellers: when your listing agreement ends"
        },
        {
          "name": "Found you through",
          "column_type": "dropdown",
          "position": 8,
          "width": 160,
          "config": "{\"options\": [\"Referral\", \"Open house\", \"Website\", \"Past client\", \"Sign call\", \"Other\"]}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 9,
          "width": 220
        }
      ],
      "alertRules": [
        {
          "name": "Expires",
          "description": "The date entered is when it runs out",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        }
      ]
    },
    {
      "key": "transactions",
      "name": "Transactions",
      "description": "Each home from the first showing to closing",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "transaction",
          "many": "transactions",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Property",
          "column_type": "text",
          "position": 0,
          "width": 210,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1,
          "description": "The street address"
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 1,
          "width": 150,
          "config": "{\"options\": [{\"label\": \"Showing\", \"color\": \"#64748b\"}, {\"label\": \"Offer made\", \"color\": \"#3b82f6\"}, {\"label\": \"Under contract\", \"color\": \"#f59e0b\"}, {\"label\": \"Clear to close\", \"color\": \"#14b8a6\"}, {\"label\": \"Closed\", \"color\": \"#22c55e\"}, {\"label\": \"Fell through\", \"color\": \"#ef4444\"}]}"
        },
        {
          "name": "Side",
          "column_type": "dropdown",
          "position": 2,
          "width": 120,
          "config": "{\"options\": [\"Buyer side\", \"Listing side\"]}"
        },
        {
          "name": "Price",
          "column_type": "currency",
          "position": 3,
          "width": 130
        },
        {
          "name": "Contract date",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "The day the contract was fully signed. The contingency dates count from here"
        },
        {
          "name": "Inspection done",
          "column_type": "date",
          "position": 5,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Inspection period\", \"log_changes\": true}",
          "description": "Date the inspection was done and any repair requests sent"
        },
        {
          "name": "Appraisal received",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Appraisal\", \"log_changes\": true}",
          "description": "Date the appraisal came back"
        },
        {
          "name": "Loan approved",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Financing contingency\", \"log_changes\": true}",
          "description": "Date the lender gave final loan approval"
        },
        {
          "name": "Closing date",
          "column_type": "date",
          "position": 8,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Closing\", \"log_changes\": true}",
          "description": "The closing date in the contract"
        },
        {
          "name": "Closed on",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Filled in when the transaction moves to Closed"
        },
        {
          "name": "Closing anniversary",
          "column_type": "date",
          "position": 10,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Closing anniversary\"}",
          "description": "Date you last sent a closing-anniversary note"
        },
        {
          "name": "Commission",
          "column_type": "currency",
          "position": 11,
          "width": 130
        }
      ],
      "alertRules": [
        {
          "name": "Inspection period",
          "description": "Inspection done within 10 days of the contract date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Contract date\"}, \"offset\": {\"days\": 10, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Under contract\", \"Clear to close\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Appraisal",
          "description": "Appraisal back within 21 days of the contract date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Contract date\"}, \"offset\": {\"days\": 21, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Under contract\", \"Clear to close\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Financing contingency",
          "description": "Loan approval within 21 days of the contract date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Contract date\"}, \"offset\": {\"days\": 21, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Under contract\", \"Clear to close\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Closing",
          "description": "The date entered is the closing, while the deal is open",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Under contract\", \"Clear to close\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Closing anniversary",
          "description": "Every year on the day it closed, 30 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\": \"calendar\", \"fromColumnMonth\": {\"column\": \"Closed on\"}, \"lead\": 30}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is\", \"values\": [\"Closed\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "checklists": [
        {
          "name": "Under contract",
          "description": "From signed contract to closing",
          "items": "[\"Earnest money deposited\", \"Inspection scheduled\", \"Repair requests sent or waived\", \"Appraisal ordered\", \"Loan application and documents with the lender\", \"Title search ordered\", \"Homeowner's insurance quote\", \"Utilities transfer arranged\", \"Final walk-through scheduled\"]"
        }
      ],
      "links": [
        {
          "to": "clients",
          "label_forward": "Client",
          "label_backward": "Transactions",
          "cardinality": "many_to_one"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "Showing",
            "color": "slate"
          },
          {
            "value": "Offer made",
            "color": "blue"
          },
          {
            "value": "Under contract",
            "color": "amber",
            "onEnter": {
              "checklist": "Under contract"
            }
          },
          {
            "value": "Clear to close",
            "color": "teal"
          },
          {
            "value": "Closed",
            "color": "green",
            "done": true,
            "onEnter": {
              "stampColumn": "Closed on",
              "activityType": "note"
            }
          },
          {
            "value": "Fell through",
            "color": "red",
            "done": true
          }
        ],
        "hideDoneAfterDays": 60
      }
    }
  ],
