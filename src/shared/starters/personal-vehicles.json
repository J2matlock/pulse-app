{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "personal-vehicles",
  "name": "Personal vehicles",
  "description": "Your household's cars: oil changes every 5,000 miles or 6 months, tire rotations, registration and insurance renewals.",
  "icon": "wrench",
  "group": "Personal",
  "keywords": [
    "car",
    "truck",
    "auto",
    "registration",
    "oil change"
  ],
  "vocab": {
    "record": {
      "one": "vehicle",
      "many": "vehicles",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": false,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": false,
    "handoff": false
  },
  "lists": [
    {
      "key": "vehicles",
      "name": "My vehicles",
      "description": "Your cars with oil changes, tire rotations, registration and insurance",
      "kind": "thing",
      "columns": [
        {
          "name": "Vehicle",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Odometer",
          "column_type": "number",
          "position": 1,
          "width": 120,
          "description": "Update it now and then; Pulse works out how fast the miles add up"
        },
        {
          "name": "Odometer at last oil change",
          "column_type": "number",
          "position": 2,
          "width": 170
        },
        {
          "name": "Last oil change",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Oil change\",\"log_changes\":true}"
        },
        {
          "name": "Odometer at last rotation",
          "column_type": "number",
          "position": 4,
          "width": 170
        },
        {
          "name": "Last rotation",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Tire rotation\",\"log_changes\":true}"
        },
        {
          "name": "Registration expires",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Insurance renews",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 8,
          "width": 200
        }
      ],
      "alertRules": [
        {
          "name": "Oil change",
          "description": "Every 5,000 miles or 6 months, whichever comes first",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "meter",
          "rule_config": "{\"kind\":\"meter\",\"readingColumnId\":{\"column\":\"Odometer\"},\"lastServiceReadingColumnId\":{\"column\":\"Odometer at last oil change\"},\"every\":5000,\"unit\":\"mi\",\"timeFallback\":{\"months\":6},\"typicalPerDay\":35}"
        },
        {
          "name": "Tire rotation",
          "description": "Every 7,500 miles",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "meter",
          "rule_config": "{\"kind\":\"meter\",\"readingColumnId\":{\"column\":\"Odometer\"},\"lastServiceReadingColumnId\":{\"column\":\"Odometer at last rotation\"},\"every\":7500,\"unit\":\"mi\",\"typicalPerDay\":35}"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "service",
