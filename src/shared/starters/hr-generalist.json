{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "hr-generalist",
  "name": "HR generalist",
  "description": "For small-business HR: probation reviews 90 days after hire, benefits eligibility at 60 days and a yearly review on each hire anniversary.",
  "icon": "users",
  "group": "Business",
  "vocab": {
    "record": {
      "one": "employee",
      "many": "employees",
      "article": "an"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "employees",
      "name": "Employees",
      "description": "Employees with probation, benefits and anniversary reviews",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Job title",
          "column_type": "text",
          "position": 1,
          "width": 170
        },
        {
          "name": "Department",
          "column_type": "dropdown",
          "position": 2,
          "width": 150,
          "config": "{\"options\":[\"Operations\",\"Sales\",\"Finance\",\"Customer service\",\"Warehouse\"]}"
        },
        {
          "name": "Manager",
          "column_type": "text",
          "position": 3,
          "width": 160
        },
        {
          "name": "Hire date",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Probation review done",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date the end-of-probation review was held",
          "config": "{\"alert_rule_name\":\"Probation ends\",\"log_changes\":true}"
        },
        {
          "name": "Benefits enrolled",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "Date the employee enrolled (or declined) benefits",
          "config": "{\"alert_rule_name\":\"Benefits eligibility\",\"log_changes\":true}"
        },
        {
          "name": "Yearly review",
          "column_type": "deadline",
          "position": 7,
          "width": 140,
          "description": "The next review, on the hire anniversary; mark it done each year",
          "config": "{\"alert_rule_name\":\"Review on hire anniversary\"}"
        },
        {
          "name": "I-9 complete",
          "column_type": "checkbox",
          "position": 8,
          "width": 110
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"On leave\",\"Former\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Probation ends",
          "description": "The probation review is due 90 days after the hire date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Hire date\"},\"offset\":{\"days\":90,\"direction\":\"after\"}}"
        },
        {
          "name": "Benefits eligibility",
          "description": "Benefits enrollment opens 60 days after the hire date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Hire date\"},\"offset\":{\"days\":60,\"direction\":\"after\"}}"
        },
        {
          "name": "Review on hire anniversary",
          "description": "The yearly review falls on the hire anniversary",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\":\"calendar\",\"fromColumnMonth\":{\"column\":\"Hire date\"},\"lead\":45}"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "meeting",
      "label": "Meeting",
      "icon": "🤝",
      "color": "green"
    },
    {
      "key": "document",
