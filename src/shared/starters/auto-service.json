{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "auto-service",
  "name": "Auto & equipment service",
  "description": "For repair shops and service businesses: customers, their vehicles or equipment, and jobs on a board from estimate to pickup, with oil-change forecasts from mileage and a follow-up call 3 days after pickup.",
  "icon": "wrench",
  "group": "Trades and service",
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true,
    "measures": false
  },
  "lists": [
    {
      "key": "customers",
      "name": "Customers",
      "description": "People and businesses you do work for",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "customer",
          "many": "customers",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 200
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 3,
          "width": 160
        },
        {
          "name": "Preferred contact",
          "column_type": "dropdown",
          "position": 4,
          "width": 150,
          "config": "{\"options\":[\"Call\",\"Text\",\"Email\"]}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 5,
          "width": 220
        }
      ]
    },
    {
      "key": "vehicles",
      "name": "Vehicles",
      "description": "Vehicles and equipment, with their owners and service due",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "vehicle",
          "many": "vehicles",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Year",
          "column_type": "number",
          "position": 0,
          "width": 90
        },
        {
          "name": "Make",
          "column_type": "text",
          "position": 1,
          "width": 120
        },
        {
          "name": "Model",
          "column_type": "text",
          "position": 2,
          "width": 130
        },
        {
          "name": "Plate",
          "column_type": "text",
          "position": 3,
          "width": 110
        },
        {
          "name": "VIN",
          "column_type": "text",
          "position": 4,
          "width": 190
        },
        {
          "name": "Odometer",
          "column_type": "number",
          "position": 5,
          "width": 120
        },
        {
          "name": "Odometer at last oil change",
          "column_type": "number",
          "position": 6,
          "width": 170
        },
        {
          "name": "Last oil change",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Oil change\",\"log_changes\":true}"
        },
        {
          "name": "State inspection",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date of the last state inspection",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Oil change",
          "description": "Every 5,000 miles or 6 months, whichever comes first",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "meter",
          "rule_config": "{\"kind\":\"meter\",\"readingColumnId\":{\"column\":\"Odometer\"},\"lastServiceReadingColumnId\":{\"column\":\"Odometer at last oil change\"},\"every\":5000,\"unit\":\"mi\",\"timeFallback\":{\"months\":6},\"typicalPerDay\":35}"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "displayFormat": "{Year} {Make} {Model}",
      "links": [
        {
          "to": "customers",
          "label_forward": "Owner",
          "label_backward": "Vehicles",
          "cardinality": "many_to_one"
        }
      ]
    },
    {
      "key": "jobs",
      "name": "Jobs",
      "description": "Work orders from estimate to pickup",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "job",
          "many": "jobs",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Job",
          "column_type": "text",
          "position": 0,
          "width": 220,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 1,
          "width": 150,
          "config": "{\"options\":[{\"label\":\"Estimate\",\"color\":\"#64748b\"},{\"label\":\"Approved\",\"color\":\"#3b82f6\"},{\"label\":\"Waiting on parts\",\"color\":\"#f59e0b\"},{\"label\":\"In progress\",\"color\":\"#f97316\"},{\"label\":\"Ready\",\"color\":\"#14b8a6\"},{\"label\":\"Picked up\",\"color\":\"#22c55e\"}]}"
        },
        {
          "name": "Concern",
          "column_type": "notes",
          "position": 2,
          "width": 220,
          "description": "What the customer asked for, in their words"
        },
        {
          "name": "Estimate",
          "column_type": "currency",
          "position": 3,
          "width": 120
        },
        {
          "name": "Promised",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "When you told the customer it would be ready",
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Picked up on",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Filled in when the job moves to Picked up"
        },
        {
          "name": "Follow-up called",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "Date you called to check everything is OK",
          "config": "{\"alert_rule_name\":\"Follow-up call\",\"log_changes\":true}"
        },
        {
          "name": "Labor hours",
          "column_type": "number",
          "position": 7,
          "width": 110
        },
        {
          "name": "Invoice total",
          "column_type": "currency",
          "position": 8,
          "width": 130
        }
      ],
      "alertRules": [
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Follow-up call",
          "description": "Call the customer 3 days after pickup",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Picked up on\"},\"offset\":{\"days\":3,\"direction\":\"after\"}}"
        }
      ],
      "links": [
        {
          "to": "vehicles",
          "label_forward": "Vehicle",
          "label_backward": "Jobs",
          "cardinality": "many_to_one"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "Estimate",
            "color": "slate"
          },
          {
            "value": "Approved",
            "color": "blue"
          },
          {
            "value": "Waiting on parts",
            "color": "amber"
          },
          {
            "value": "In progress",
            "color": "orange"
          },
          {
            "value": "Ready",
            "color": "teal"
          },
          {
            "value": "Picked up",
            "color": "green",
            "done": true,
            "onEnter": {
              "stampColumn": "Picked up on",
              "activityType": "note"
            }
          }
        ],
        "hideDoneAfterDays": 14
      }
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "call",
