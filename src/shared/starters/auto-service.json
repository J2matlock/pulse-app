      "color": "blue"
    },
    {
      "key": "text",
      "label": "Text",
      "icon": "💬",
      "color": "teal"
    }
  ],
  "documentTemplates": [
    {
      "name": "Oil change reminder",
      "content": "{{today}}\n\nHi {{linked:Owner.Name}},\n\nYour {{name}} is coming up on its next oil change: {{deadline:Last oil change}}.\n\nGive us a call or reply to book a time.\n\nThanks,\n\n{{my_name}}"
    }
  ],
