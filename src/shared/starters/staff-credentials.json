{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "staff-credentials",
  "name": "Staff credentials",
  "description": "Keep every staff member's certifications, TB tests, background checks and licenses current, with warnings before anything expires.",
  "icon": "id-card",
  "group": "Business",
  "keywords": [
    "certification",
    "training",
    "staff",
    "cpr",
    "license"
  ],
  "vocab": {
    "record": {
      "one": "staff member",
      "many": "staff",
      "article": "a"
    },
    "list": {
      "one": "roster",
      "many": "rosters",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "staff",
      "name": "Staff roster",
      "description": "Staff with the certificates, tests and checks each one needs to keep current",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Role",
          "column_type": "dropdown",
          "position": 1,
          "width": 140,
          "is_required": 1,
          "config": "{\"options\":[\"Aide\",\"Nurse\",\"Driver\",\"Teacher\",\"Office\",\"Other\"]}"
        },
        {
          "name": "Hire date",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 3,
          "width": 140
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 4,
          "width": 200
        },
        {
          "name": "CPR/First aid expires",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "TB test date",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "The date of the last TB test; due again a year later",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Background check date",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "The date of the last background check; due again every two years",
          "config": "{\"alert_rule_name\":\"Every 2 years\",\"log_changes\":true}"
        },
        {
          "name": "License number",
          "column_type": "text",
          "position": 8,
          "width": 160,
          "description": "For roles that need a license (nurse, driver, teacher)"
        },
        {
          "name": "License expires",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Orientation done",
          "column_type": "checkbox",
          "position": 10,
          "width": 120
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 11,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"On leave\",\"Former\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (60-day warning)",
          "description": "The date entered is when it expires; warns 60, 30, 14 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":14,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 2 years",
          "description": "Due 2 years after the date entered",
          "interval_months": 24,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "reminder",
      "label": "Reminder sent",
      "icon": "🔔",
      "color": "amber"
    },
    {
      "key": "document",
      "label": "Document received",
      "icon": "📄",
      "color": "green"
    }
  ],
  "documentTemplates": [
    {
      "name": "Renewal reminder",
      "content": "{{today}}\n\nDear {{name}},\n\nOur records show your CPR/First aid certification is due for renewal: {{deadline:CPR/First aid expires}}.\n\nPlease sign up for a class and bring a copy of your new card to the office when you have it.\n\nThank you,\n\n{{my_name}}"
    }
  ],
