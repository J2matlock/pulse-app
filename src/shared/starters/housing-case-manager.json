{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "housing-case-manager",
  "name": "Housing case manager",
  "description": "For housing and homeless services: monthly contacts, housing plan reviews every 6 months, lease end dates and yearly income recertification, with a one-contact-a-month requirement.",
  "icon": "home",
  "group": "Human services",
  "vocab": {
    "record": {
      "one": "client",
      "many": "clients",
      "article": "a"
    },
    "list": {
      "one": "caseload",
      "many": "caseloads",
      "article": "a"
    },
    "activity": {
      "one": "case note",
      "many": "case notes",
      "article": "a"
    },
    "activityLog": {
      "one": "case log",
      "many": "case logs",
      "article": "a"
    },
    "contactDirectory": {
      "one": "contacts",
      "many": "contacts",
      "article": "a",
      "oneCap": "Contacts",
      "manyCap": "Contacts"
    },
    "contact": {
      "one": "provider",
      "many": "providers",
      "article": "a"
    },
    "priority": {
      "one": "acuity level",
      "many": "acuity levels",
      "article": "an"
    },
    "archive": {
      "one": "archive",
      "many": "archives",
      "article": "an"
    },
    "worker": {
      "one": "case manager",
      "many": "case managers",
      "article": "a"
    },
    "requirement": {
      "one": "contact requirement",
      "many": "contact requirements",
      "article": "a"
    },
    "appointment": {
      "one": "appointment",
      "many": "appointments",
      "article": "an"
    },
    "stage": {
      "one": "stage",
      "many": "stages",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": true,
    "contactsDirectory": true,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true
  },
  "lists": [
    {
      "key": "caseload",
      "name": "Housing caseload",
      "description": "Participants with housing plans, leases and recertifications",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 2,
          "width": 160
        },
        {
          "name": "Program",
          "column_type": "dropdown",
          "position": 3,
          "width": 200,
          "config": "{\"options\":[\"Rapid rehousing\",\"Permanent supportive housing\",\"Prevention\",\"Outreach\"]}"
        },
        {
          "name": "Last contact",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Housing plan review",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date of the last housing plan review; due again in 6 months",
          "config": "{\"alert_rule_name\":\"Every 6 months\",\"log_changes\":true}"
        },
        {
          "name": "Lease end",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Income recertification",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "Date of the last income recertification; due again a year later",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Landlord",
          "column_type": "text",
          "position": 8,
          "width": 160
        },
        {
          "name": "Landlord phone",
          "column_type": "phone",
          "position": 9,
          "width": 140
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 120,
          "config": "{\"options\":[\"Housed\",\"Searching\",\"Shelter\",\"Exited\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Contact",
          "note_types": [
            "visit",
            "phone",
            "meeting"
          ],
          "per_month": 1
        }
      ]
    }
  ],
