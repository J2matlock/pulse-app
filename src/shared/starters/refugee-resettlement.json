{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "refugee-resettlement",
  "name": "Refugee resettlement",
  "description": "For resettlement case managers: milestones from arrival (home visit in 5 days, core services in 30 days, 90- and 180-day check-ins) and two contacts a month.",
  "icon": "home",
  "group": "Human services",
  "keywords": [
    "refugee",
    "immigrant",
    "resettlement",
    "asylum"
  ],
  "vocab": {
    "record": {
      "one": "client",
      "many": "clients",
      "article": "a"
    },
    "list": {
      "one": "caseload",
      "many": "caseloads",
      "article": "a"
    },
    "activity": {
      "one": "case note",
      "many": "case notes",
      "article": "a"
    },
    "activityLog": {
      "one": "case log",
      "many": "case logs",
      "article": "a"
    },
    "contactDirectory": {
      "one": "contacts",
      "many": "contacts",
      "article": "a",
      "oneCap": "Contacts",
      "manyCap": "Contacts"
    },
    "contact": {
      "one": "provider",
      "many": "providers",
      "article": "a"
    },
    "priority": {
      "one": "acuity level",
      "many": "acuity levels",
      "article": "an"
    },
    "archive": {
      "one": "archive",
      "many": "archives",
      "article": "an"
    },
    "worker": {
      "one": "case manager",
      "many": "case managers",
      "article": "a"
    },
    "requirement": {
      "one": "contact requirement",
      "many": "contact requirements",
      "article": "a"
    },
    "appointment": {
      "one": "appointment",
      "many": "appointments",
      "article": "an"
    },
    "stage": {
      "one": "stage",
      "many": "stages",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": true,
    "contactsDirectory": true,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true
  },
  "lists": [
    {
      "key": "caseload",
      "name": "Resettlement caseload",
      "description": "Families from arrival through the first six months",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Country of origin",
          "column_type": "text",
          "position": 1,
          "width": 150
        },
        {
          "name": "Language",
          "column_type": "dropdown",
          "position": 2,
          "width": 130,
          "config": "{\"options\":[\"Arabic\",\"Dari\",\"Pashto\",\"Spanish\",\"Swahili\",\"Ukrainian\",\"Burmese\"]}"
        },
        {
          "name": "Arrival date",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Milestones",
          "column_type": "deadline",
          "position": 4,
          "width": 140,
          "description": "The next resettlement step; mark it done to move on",
          "config": "{\"alert_rule_name\":\"Resettlement milestones\"}"
        },
        {
          "name": "Household size",
          "column_type": "number",
          "position": 5,
          "width": 120
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 6,
          "width": 160
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 7,
          "width": 140
        },
        {
          "name": "Employment",
          "column_type": "dropdown",
          "position": 8,
          "width": 130,
          "config": "{\"options\":[\"Employed\",\"Job search\",\"In training\",\"Not yet\"]}"
        },
        {
          "name": "Last contact",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Resettlement milestones",
          "description": "From arrival: home visit in 5 days, core services in 30 days, then 90- and 180-day check-ins",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "sequence",
          "rule_config": "{\"kind\":\"sequence\",\"anchorColumnId\":{\"column\":\"Arrival date\"},\"steps\":[{\"label\":\"Home visit\",\"offset\":{\"days\":5}},{\"label\":\"Core services done\",\"offset\":{\"days\":30}},{\"label\":\"90-day check-in\",\"offset\":{\"days\":90}},{\"label\":\"180-day check-in\",\"offset\":{\"days\":180}}]}"
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Contact",
          "note_types": [
            "visit",
            "phone",
            "meeting"
          ],
          "per_month": 2
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "orientation",
      "label": "Cultural orientation",
      "icon": "🧭",
      "color": "teal"
    },
    {
      "key": "escort",
      "label": "Appointment escort",
      "icon": "🚗",
      "color": "amber"
    }
  ],
