{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "representative-payee",
  "name": "Representative payee",
  "description": "For organizational payees: the yearly accounting report, a monthly budget review for each beneficiary, rent and benefit reviews. Pulse is a tracking aid, not your official record system.",
  "icon": "file-badge",
  "group": "Legal and government",
  "keywords": [
    "payee",
    "ssi",
    "benefits",
    "budget"
  ],
  "vocab": {
    "record": {
      "one": "beneficiary",
      "many": "beneficiaries",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "beneficiaries",
      "name": "Beneficiaries",
      "description": "People whose benefits you manage, with the yearly accounting and monthly budgets",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Annual accounting",
          "column_type": "deadline",
          "position": 1,
          "width": 140,
          "description": "The yearly payee report; mark it done when sent",
          "config": "{\"alert_rule_name\":\"Annual accounting\"}"
        },
        {
          "name": "Benefit review",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "description": "Date of the next benefit review or redetermination",
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 3,
          "width": 140
        },
        {
          "name": "Benefit",
          "column_type": "dropdown",
          "position": 4,
          "width": 120,
          "config": "{\"options\":[\"SSI\",\"SSDI\",\"Retirement\",\"Survivor\",\"VA\"]}"
        },
        {
          "name": "Monthly benefit",
          "column_type": "currency",
          "position": 5,
          "width": 140
        },
        {
          "name": "Payee since",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Rent",
          "column_type": "currency",
          "position": 7,
          "width": 110
        },
        {
          "name": "Living situation",
          "column_type": "dropdown",
          "position": 8,
          "width": 150,
          "config": "{\"options\":[\"Own apartment\",\"Group home\",\"With family\",\"Nursing home\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Annual accounting",
          "description": "The yearly payee report, on the anniversary of becoming payee",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\":\"calendar\",\"fromColumnMonth\":{\"column\":\"Payee since\"},\"lead\":60}"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Budget review",
          "note_types": [
            "budget"
          ],
          "per_month": 1
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "budget",
      "label": "Budget review",
      "icon": "📒",
      "color": "teal"
    },
    {
      "key": "bill",
      "label": "Bill paid",
      "icon": "💵",
      "color": "green"
    }
  ],
