{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "workplace-safety",
  "name": "Workplace safety training",
  "description": "OSHA-style training records: forklift, first aid, hazard communication, fall protection, respirator fit tests and hearing tests, with what each employee is due for. Pulse is a tracking aid, not your official record system.",
  "icon": "hard-hat",
  "group": "Property and safety",
  "vocab": {
    "record": {
      "one": "employee",
      "many": "employees",
      "article": "an"
    },
    "list": {
      "one": "roster",
      "many": "rosters",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "employees",
      "name": "Safety roster",
      "description": "Employees and the safety training each one is due for",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Department",
          "column_type": "dropdown",
          "position": 1,
          "width": 140,
          "is_required": 1,
          "config": "{\"options\":[\"Warehouse\",\"Production\",\"Maintenance\",\"Shipping\",\"Office\"]}"
        },
        {
          "name": "Hire date",
          "column_type": "date",
          "position": 2,
          "width": 150
        },
        {
          "name": "Forklift certified",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "description": "Date of the last forklift evaluation; due again every 3 years",
          "config": "{\"alert_rule_name\":\"Every 3 years\",\"log_changes\":true}"
        },
        {
          "name": "First aid/CPR expires",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Hazard communication",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date of the last hazard communication training",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Fall protection",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "Date of the last fall protection training",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Respirator fit test",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "Date of the last fit test",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Hearing test",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date of the last hearing test",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"On leave\",\"Former\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 3 years",
          "description": "Due 3 years after the date entered",
          "interval_months": 36,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Expires (60-day warning)",
          "description": "The date entered is when it expires; warns 60, 30, 14 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":14,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
