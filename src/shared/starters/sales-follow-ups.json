{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "sales-follow-ups",
  "name": "Sales & follow-ups",
  "description": "A simple sales pipeline: leads on a board from new to won or lost, what each is worth, and when to follow up next.",
  "icon": "users",
  "group": "Business",
  "keywords": [
    "sales",
    "leads",
    "crm",
    "customers",
    "prospects"
  ],
  "vocab": {
    "record": {
      "one": "lead",
      "many": "leads",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "stages": true
  },
  "lists": [
    {
      "key": "leads",
      "name": "Leads",
      "description": "People you're talking to about work, and when to follow up",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Next follow-up",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Company",
          "column_type": "text",
          "position": 2,
          "width": 180
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 3,
          "width": 140
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 4,
          "width": 200
        },
        {
          "name": "Source",
          "column_type": "dropdown",
          "position": 5,
          "width": 150,
          "config": "{\"options\":[\"Referral\",\"Website\",\"Event\",\"Cold call\",\"Repeat customer\"]}"
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 6,
          "width": 130,
          "config": "{\"options\":[{\"label\":\"New\",\"color\":\"#64748b\"},{\"label\":\"Contacted\",\"color\":\"#3b82f6\"},{\"label\":\"Proposal\",\"color\":\"#a855f7\"},{\"label\":\"Won\",\"color\":\"#22c55e\"},{\"label\":\"Lost\",\"color\":\"#ef4444\"}]}"
        },
        {
          "name": "Value",
          "column_type": "currency",
          "position": 7,
          "width": 110
        },
        {
          "name": "Closed on",
          "column_type": "date",
          "position": 8,
          "width": 150
        }
      ],
      "alertRules": [
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "New",
            "color": "slate"
          },
          {
            "value": "Contacted",
            "color": "blue"
          },
          {
            "value": "Proposal",
            "color": "purple"
          },
          {
            "value": "Won",
            "color": "green",
            "done": true,
            "onEnter": {
              "stampColumn": "Closed on"
            }
          },
          {
            "value": "Lost",
            "color": "red",
            "done": true,
            "onEnter": {
              "stampColumn": "Closed on"
            }
          }
        ],
        "hideDoneAfterDays": 30
      }
    }
  ],
  "activityTypes": [
    {
      "key": "call",
      "label": "Call",
      "icon": "📞",
      "color": "blue"
    }
  ],
