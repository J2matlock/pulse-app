    "attachments": true,
    "notifications": true
  },
  "lists": [
    {
      "key": "parents",
      "name": "Parents",
      "description": "The people you look after, with their check-ups, medications and renewals",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 170,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 140
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 3,
          "width": 200
        },
        {
          "name": "Allergies",
          "column_type": "text",
          "position": 4,
          "width": 160
        },
        {
          "name": "Insurance",
          "column_type": "dropdown",
          "position": 5,
          "width": 170,
          "config": "{\"options\":[\"Medicare\",\"Medicare Advantage\",\"Medicare + supplement\",\"Medicaid\",\"Other\"]}"
        },
        {
          "name": "Medication review",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "description": "Last time a doctor or pharmacist went over all the medications; again every 3 months",
          "config": "{\"alert_rule_name\":\"Every 3 months\",\"log_changes\":true}"
        },
        {
          "name": "Wellness visit",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "Last yearly check-up",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Insurance renews",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "When the plan renews or open enrollment ends",
          "config": "{\"alert_rule_name\":\"Renews (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Benefits renewal",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Medicaid, food or housing benefits paperwork due",
          "config": "{\"alert_rule_name\":\"Renews (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Power of attorney",
          "column_type": "dropdown",
          "position": 10,
          "width": 150,
          "description": "Keep a copy in Files on their page",
          "config": "{\"options\":[\"On file\",\"Not yet\",\"Not needed\"]}"
        },
        {
          "name": "Health care proxy",
          "column_type": "dropdown",
          "position": 11,
          "width": 150,
          "description": "Keep a copy in Files on their page",
          "config": "{\"options\":[\"On file\",\"Not yet\",\"Not needed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 3 months",
          "description": "Due 3 months after the date entered",
          "interval_months": 3,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":15,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Renews (60-day warning)",
          "description": "The date entered is when it renews",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "care-team",
