{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "caring-for-a-parent",
  "name": "Caring for a parent",
  "description": "For family caregivers: a parent's doctor visits on the calendar, medication reviews every 3 months, yearly check-ups, insurance and benefits renewals, their care team, and copies of the power of attorney and insurance cards kept safe in Files.",
  "icon": "hand-heart",
  "group": "Personal",
  "vocab": {
    "record": {
      "one": "parent",
      "many": "parents",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": false,
