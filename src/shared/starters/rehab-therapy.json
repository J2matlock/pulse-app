          "config": "{\"log_changes\": true}"
        }
      ],
      "alertRules": [
        {
          "name": "Physician order",
          "description": "Signed order due 30 days after the evaluation",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Evaluation date\"}, \"offset\": {\"days\": 30, \"direction\": \"after\"}}"
        },
        {
          "name": "Plan of care recert",
          "description": "Recertify the plan of care every 90 days",
          "interval_days": 90,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is_not\", \"values\": [\"Discharged\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Visits left",
          "description": "Counts visits between the authorization start and end dates",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\": \"quota\", \"activityTypes\": [\"evaluation\", \"visit\", \"progress\"], \"limitColumnId\": {\"column\": \"Visits authorized\"}, \"startColumnId\": {\"column\": \"Authorization start\"}, \"endColumnId\": {\"column\": \"Authorization end\"}, \"warnRemaining\": 3, \"warnDaysBeforeEnd\": 14}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is_not\", \"values\": [\"Discharged\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Progress note every 10 visits",
          "description": "Counts treatment visits since the last progress note; one is due by the 10th",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\": \"quota\", \"activityTypes\": [\"visit\"], \"limit\": 10, \"startColumnId\": {\"column\": \"Last progress note\"}, \"endColumnId\": {\"column\": \"Authorization end\"}, \"warnRemaining\": 2, \"warnDaysBeforeEnd\": 0}",
          "rule_condition": "{\"columnId\": {\"column\": \"Stage\"}, \"op\": \"is_not\", \"values\": [\"Discharged\"], \"whenFalse\": \"hide\"}"
        }
      ],
