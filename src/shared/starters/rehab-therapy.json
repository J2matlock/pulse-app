  "documentTemplates": [
    {
      "name": "Physician signature request",
      "content": "{{today}}\n\nDear {{linked:Referred by.Name}},\n\nRe: {{name}}, born {{field:Date of birth}}\n\nWe evaluated {{name}} for {{field:Discipline}} on {{field:Evaluation date}}. The plan of care that started on {{field:Plan of care start}} is enclosed.\n\nPlease sign and return it so treatment can continue without a break. You can fax it back to us.\n\nThank you,\n\n{{my_name}}"
    },
    {
      "name": "Authorization request",
      "content": "{{today}}\n\nRe: {{name}}, born {{field:Date of birth}}\n\nThe current authorization of {{field:Visits authorized}} {{field:Discipline}} visits ends on {{field:Authorization end}}. {{name}} is making progress toward the goals in the plan of care, and we are asking for more visits to continue treatment.\n\nThe latest progress note was written on {{field:Last progress note}}.\n\nThank you,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Twice-weekly visits",
      "body": "On a patient's page, add an appointment and choose Repeat weekly; add a second one for the other day. Marking a visit done writes its Treatment visit note, which counts toward Visits left and Progress note due."
    },
    {
      "title": "Progress notes",
      "body": "Write a note of the kind Progress note, then change Last progress note to today. The count of treatment visits starts again, and Progress note due warns as you get close to 10."
    },
    {
      "title": "Signed orders",
      "body": "The order is due 30 days after the Evaluation date. Fill in Order signed on when it comes back, and drop the signed copy into Files on the patient's page."
    },
    {
      "title": "Plan of care",
      "body": "Change Plan of care start each time you recertify. Pulse reminds you 90 days later, and stops once the patient is discharged."
    }
  ],
