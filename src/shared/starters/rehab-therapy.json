          "config": "{\"options\": [{\"label\": \"Evaluation\", \"color\": \"#64748b\"}, {\"label\": \"Active\", \"color\": \"#3b82f6\"}, {\"label\": \"On hold\", \"color\": \"#f59e0b\"}, {\"label\": \"Discharged\", \"color\": \"#22c55e\"}]}"
        },
