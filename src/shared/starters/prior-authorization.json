{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "prior-authorization",
  "name": "Prior authorization tracker",
  "description": "For therapy and clinic offices: how many authorized visits each patient has left and when each authorization ends, so renewals go in on time.",
  "icon": "stethoscope",
  "group": "Health",
  "keywords": [
    "insurance",
    "authorization",
    "medicaid",
    "visits",
    "units"
  ],
  "vocab": {
    "record": {
      "one": "patient",
      "many": "patients",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "patients",
      "name": "Authorizations",
      "description": "Patients with insurance authorizations and how many visits are left",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 150
        },
        {
          "name": "Insurance",
          "column_type": "dropdown",
          "position": 2,
          "width": 170,
          "config": "{\"options\":[\"Medicaid\",\"Medicare Advantage\",\"Blue Plan\",\"Choice Health\",\"Other\"]}"
        },
        {
          "name": "Authorization number",
          "column_type": "text",
          "position": 3,
          "width": 170
        },
        {
          "name": "Visits authorized",
          "column_type": "number",
          "position": 4,
          "width": 130,
          "is_required": 1
        },
        {
          "name": "Authorization start",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Authorization end",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "is_required": 1
        },
        {
          "name": "Visits left",
          "column_type": "deadline",
          "position": 7,
          "width": 140,
          "description": "Visits used against the authorization, and when it ends",
          "config": "{\"alert_rule_name\":\"Visits left\"}"
        },
        {
          "name": "Service",
          "column_type": "dropdown",
          "position": 8,
          "width": 170,
          "config": "{\"options\":[\"Physical therapy\",\"Occupational therapy\",\"Speech therapy\",\"Counseling\"]}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 160,
          "config": "{\"options\":[\"Active\",\"Renewal requested\",\"Discharged\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Visits left",
          "description": "Counts visits between the authorization start and end dates",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\":\"quota\",\"activityTypes\":[\"visit\"],\"limitColumnId\":{\"column\":\"Visits authorized\"},\"startColumnId\":{\"column\":\"Authorization start\"},\"endColumnId\":{\"column\":\"Authorization end\"},\"warnRemaining\":2,\"warnDaysBeforeEnd\":14}"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "visit",
      "label": "Visit",
      "icon": "🏥",
      "color": "orange"
    },
    {
      "key": "no_show",
      "label": "No-show",
      "icon": "🚫",
      "color": "red"
    }
  ],
