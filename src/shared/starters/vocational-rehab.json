      "many": "stages",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": true,
    "contactsDirectory": true,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true
  },
  "lists": [
    {
      "key": "caseload",
      "name": "VR caseload",
      "description": "People from application through 90 days of work",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Plan signed",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "description": "Date the employment plan was signed",
          "config": "{\"alert_rule_name\":\"Plan due\",\"log_changes\":true}"
        },
        {
          "name": "Follow-up done",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "description": "Date of the 90-day follow-up after starting work",
          "config": "{\"alert_rule_name\":\"Placement follow-up\",\"log_changes\":true}"
        },
        {
          "name": "Last contact",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 4,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Application date",
          "column_type": "date",
          "position": 5,
          "width": 150
        },
        {
          "name": "Eligibility date",
          "column_type": "date",
          "position": 6,
          "width": 150
        },
        {
          "name": "Job goal",
          "column_type": "text",
          "position": 7,
          "width": 170
        },
        {
          "name": "Job start date",
          "column_type": "date",
          "position": 8,
          "width": 150
        },
        {
          "name": "Employer",
          "column_type": "text",
          "position": 9,
          "width": 160
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 120,
          "config": "{\"options\":[\"Applicant\",\"Eligible\",\"Plan\",\"Employed\",\"Closed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Plan due",
          "description": "The employment plan is due 90 days after eligibility",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Eligibility date\"},\"offset\":{\"days\":90,\"direction\":\"after\"}}"
        },
        {
          "name": "Placement follow-up",
          "description": "Close successfully after 90 days in the job",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Job start date\"},\"offset\":{\"days\":90,\"direction\":\"after\"}}"
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "job_development",
      "label": "Job development",
      "icon": "💼",
      "color": "teal"
    }
  ],
