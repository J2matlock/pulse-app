{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "animal-rescue",
  "name": "Animal rescue",
  "description": "For rescues and shelters: animals on a board from intake to adoption, which foster home each is with, vaccines and vet visits, and foster home checks.",
  "icon": "paw-print",
  "group": "Animals",
  "keywords": [
    "pet",
    "dog",
    "cat",
    "shelter",
    "adoption",
    "foster",
    "vet"
  ],
  "vocab": {
    "record": {
      "one": "animal",
      "many": "animals",
      "article": "an"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true,
    "attachments": true
  },
  "lists": [
    {
      "key": "animals",
      "name": "Animals",
      "description": "Animals from intake to adoption",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "animal",
          "many": "animals",
          "article": "an"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 140,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Rabies vaccine",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "description": "Date of the last rabies vaccine",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Next vet visit",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Species",
          "column_type": "dropdown",
          "position": 3,
          "width": 110,
          "config": "{\"options\":[\"Dog\",\"Cat\",\"Rabbit\",\"Other\"]}"
        },
        {
          "name": "Breed",
          "column_type": "text",
          "position": 4,
          "width": 150
        },
        {
          "name": "Sex",
          "column_type": "dropdown",
          "position": 5,
          "width": 100,
          "config": "{\"options\":[\"Female\",\"Male\"]}"
        },
        {
          "name": "Intake date",
          "column_type": "date",
          "position": 6,
          "width": 150
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 7,
          "width": 160,
          "config": "{\"options\":[{\"label\":\"Intake\",\"color\":\"#64748b\"},{\"label\":\"Medical\",\"color\":\"#f97316\"},{\"label\":\"Ready\",\"color\":\"#3b82f6\"},{\"label\":\"Adoption pending\",\"color\":\"#a855f7\"},{\"label\":\"Adopted\",\"color\":\"#22c55e\"}]}"
        },
        {
          "name": "Spayed/neutered",
          "column_type": "checkbox",
          "position": 8,
          "width": 130
        },
        {
          "name": "Microchip",
          "column_type": "text",
          "position": 9,
          "width": 150
        },
        {
          "name": "Adopted on",
          "column_type": "date",
          "position": 10,
          "width": 150
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "fosters",
          "label_forward": "Placed with",
          "label_backward": "Animals in care",
          "cardinality": "many_to_one"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "Intake",
            "color": "slate"
          },
          {
            "value": "Medical",
            "color": "orange"
          },
          {
            "value": "Ready",
            "color": "blue"
          },
          {
            "value": "Adoption pending",
            "color": "purple"
          },
          {
            "value": "Adopted",
            "color": "green",
            "done": true,
            "onEnter": {
              "stampColumn": "Adopted on"
            }
          }
        ],
        "hideDoneAfterDays": 30
      }
    },
    {
      "key": "fosters",
      "name": "Fosters",
      "description": "Foster homes and what they can take",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "foster",
          "many": "fosters",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Home check",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "description": "Date of the last home check; due again every 2 years",
          "config": "{\"alert_rule_name\":\"Every 2 years\",\"log_changes\":true}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 3,
          "width": 200
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 4,
          "width": 160
        },
        {
          "name": "Can take",
          "column_type": "tag",
          "position": 5,
          "width": 140,
          "description": "Dogs, cats, puppies, kittens, medical cases…"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 6,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"Full\",\"On a break\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 2 years",
          "description": "Due 2 years after the date entered",
          "interval_months": 24,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "vet",
      "label": "Vet visit",
      "icon": "🩺",
      "color": "orange"
    },
    {
      "key": "application",
      "label": "Adoption application",
      "icon": "📝",
      "color": "purple"
    }
  ],
