    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": false,
    "measures": true,
    "appointments": true,
    "forms": true,
    "attachments": true
  },
