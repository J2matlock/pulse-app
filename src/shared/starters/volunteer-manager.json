{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "volunteer-manager",
  "name": "Volunteer manager",
  "description": "For any nonprofit that runs on volunteers: orientation within 30 days of signing up, background checks for the roles that need them, yearly training, a nudge when someone hasn’t been in for 60 days, hours given and thank-yous.",
  "icon": "hand-helping",
  "group": "Faith and community",
  "keywords": [
    "volunteer",
    "shifts",
    "nonprofit"
  ],
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
