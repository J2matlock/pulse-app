      "label": "Training",
      "icon": "🎓",
      "color": "purple"
    },
    {
      "key": "thank_you",
      "label": "Thank-you",
      "icon": "💐",
      "color": "amber"
    },
    {
      "key": "call",
      "label": "Call",
      "icon": "📞",
      "color": "blue"
    }
  ],
  "measures": [
    {
      "key": "hours_given",
      "label": "Hours given",
      "kind": "hours",
      "decimals": 1
    }
  ],
  "documentTemplates": [
    {
      "name": "Welcome letter",
      "content": "{{today}}\n\nDear {{name}},\n\nWelcome, and thank you for signing up to volunteer with us!\n\nYour next step is orientation, where you will meet the team, take a tour and get your badge. Please come to one within the next few weeks.\n\nIf you have any questions, just call or reply to this letter.\n\nWith thanks,\n\n{{my_name}}"
    },
    {
      "name": "Thank-you letter",
      "content": "{{today}}\n\nDear {{name}},\n\nWe wanted to stop and say thank you. You have now given {{field:Total hours}} hours to our community.\n\nThat time made a real difference to the people we serve, and to everyone who works beside you.\n\nWith gratitude,\n\n{{my_name}}"
    }
  ],
  "helpTips": [
    {
      "title": "Hours",
      "body": "Log each shift as a Shift note and fill in Hours given. Reports can total hours by volunteer or by month. Keep Total hours up to date, then sort or filter by it to see who has passed 100, 250 or 500 hours and send the Thank-you letter."
    },
    {
      "title": "Background checks",
      "body": "Set Needs background check to Yes for volunteers whose roles involve children, vulnerable adults, money or keys. Only they get the every-2-years reminder."
    },
    {
      "title": "Keeping in touch",
      "body": "Fill in Last shift when someone comes in. If an active volunteer has not been in for 60 days, Checked in comes due: give them a call. Volunteers on a break are left alone."
    },
    {
      "title": "Paperwork",
      "body": "Drop signed waivers and background check results into Files on the volunteer’s page. They are stored encrypted inside Pulse."
    }
  ],
  "lists": [
    {
      "key": "volunteers",
      "name": "Volunteers",
      "description": "Everyone who gives their time, with orientation, checks and training due",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "volunteer",
          "many": "volunteers",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Orientation done",
          "column_type": "date",
          "position": 1,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Orientation\", \"log_changes\": true}",
          "description": "Date they finished orientation; due within 30 days of signing up"
        },
        {
          "name": "Background check",
          "column_type": "date",
          "position": 2,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Background check\", \"log_changes\": true}",
          "description": "Date of the last check; renews every 2 years"
        },
        {
          "name": "Last training",
          "column_type": "date",
          "position": 3,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Date of the last yearly refresher"
        },
        {
          "name": "Checked in",
          "column_type": "date",
          "position": 4,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Check-in\", \"log_changes\": true}",
          "description": "Date you last called or wrote to someone you haven’t seen in 60 days"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 5,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 6,
          "width": 200
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 7,
          "width": 130,
          "config": "{\"options\": [\"Active\", \"On a break\", \"Moved on\"]}",
          "default_value": "Active"
        },
        {
          "name": "Signed up",
          "column_type": "date",
          "position": 8,
          "width": 140,
          "description": "The day they signed up",
          "config": "{\"log_changes\": true}"
        },
        {
          "name": "Needs background check",
          "column_type": "dropdown",
          "position": 9,
          "width": 190,
          "config": "{\"options\": [\"Yes\", \"No\"]}",
          "description": "Yes for roles with children, vulnerable adults, money or keys"
        },
        {
          "name": "Last shift",
          "column_type": "date",
          "position": 10,
          "width": 140,
          "description": "The last time they came in",
          "config": "{\"log_changes\": true}"
        },
        {
          "name": "Total hours",
          "column_type": "number",
          "position": 11,
          "width": 120,
          "description": "All the hours they have given; thank them at 100, 250 and 500"
        },
        {
          "name": "Emergency contact",
          "column_type": "text",
          "position": 12,
          "width": 200
        }
      ],
      "alertRules": [
        {
          "name": "Orientation",
          "description": "Due 30 days after signing up",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Signed up\"}, \"offset\": {\"days\": 30, \"direction\": \"after\"}}"
        },
        {
          "name": "Background check",
          "description": "Every 2 years, only for volunteers who need one",
          "interval_months": 24,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "rule_condition": "{\"columnId\": {\"column\": \"Needs background check\"}, \"op\": \"is\", \"values\": [\"Yes\"], \"whenFalse\": \"hide\"}"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Check-in",
          "description": "Reach out 60 days after their last shift, while they are active",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\": \"relative\", \"anchorColumnId\": {\"column\": \"Last shift\"}, \"offset\": {\"days\": 60, \"direction\": \"after\"}}",
          "rule_condition": "{\"columnId\": {\"column\": \"Status\"}, \"op\": \"is\", \"values\": [\"Active\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "checklists": [
        {
          "name": "New volunteer",
          "description": "From sign-up to first shift",
          "items": "[\"Application and emergency contact on file\", \"Signed waiver and confidentiality agreement in Files\", \"Background check sent (if their role needs one)\", \"Orientation done\", \"Name badge and shirt\", \"First shift scheduled with a buddy\", \"Welcome letter sent\"]"
        }
      ],
