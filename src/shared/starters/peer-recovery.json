{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "peer-recovery",
  "name": "Peer recovery specialist",
  "description": "For peer recovery and recovery coaching: a weekly contact requirement, recovery plan reviews every 90 days and milestones at 30, 60 and 90 days, 6 months and every year.",
  "icon": "sprout",
  "group": "Human services",
  "vocab": {
    "record": {
      "one": "client",
      "many": "clients",
      "article": "a"
    },
    "list": {
      "one": "caseload",
      "many": "caseloads",
      "article": "a"
    },
    "activity": {
      "one": "case note",
      "many": "case notes",
      "article": "a"
    },
    "activityLog": {
      "one": "case log",
      "many": "case logs",
      "article": "a"
    },
    "contactDirectory": {
      "one": "contacts",
      "many": "contacts",
      "article": "a",
      "oneCap": "Contacts",
      "manyCap": "Contacts"
    },
    "contact": {
      "one": "provider",
      "many": "providers",
      "article": "a"
    },
    "priority": {
      "one": "acuity level",
      "many": "acuity levels",
      "article": "an"
    },
    "archive": {
      "one": "archive",
      "many": "archives",
      "article": "an"
    },
    "worker": {
      "one": "case manager",
      "many": "case managers",
      "article": "a"
    },
    "requirement": {
      "one": "contact requirement",
      "many": "contact requirements",
      "article": "a"
    },
    "appointment": {
      "one": "appointment",
      "many": "appointments",
      "article": "an"
    },
    "stage": {
      "one": "stage",
      "many": "stages",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": true,
    "contactsDirectory": true,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": true,
    "letters": true,
    "summaryReport": true,
    "handoff": true
  },
  "lists": [
    {
      "key": "caseload",
      "name": "Peer support caseload",
      "description": "People in recovery you meet with each week",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Recovery start date",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "description": "The milestones count from this date"
        },
        {
          "name": "Milestones",
          "column_type": "deadline",
          "position": 3,
          "width": 140,
          "description": "The next milestone to celebrate; mark it done to move to the next",
          "config": "{\"alert_rule_name\":\"Recovery milestones\"}"
        },
        {
          "name": "Recovery plan review",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last recovery plan review; due again in 90 days",
          "config": "{\"alert_rule_name\":\"Every 90 days\",\"log_changes\":true}"
        },
        {
          "name": "Last contact",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Supports",
          "column_type": "tag",
          "position": 6,
          "width": 140,
          "description": "Meetings, sponsor, groups, faith community…"
        },
        {
          "name": "Emergency contact",
          "column_type": "text",
          "position": 7,
          "width": 160
        },
        {
          "name": "Emergency phone",
          "column_type": "phone",
          "position": 8,
          "width": 140
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 130,
          "config": "{\"options\":[\"Active\",\"Re-engaging\",\"Graduated\",\"Closed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Recovery milestones",
          "description": "Milestones counted from the recovery start date",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "sequence",
          "rule_config": "{\"kind\":\"sequence\",\"anchorColumnId\":{\"column\":\"Recovery start date\"},\"steps\":[{\"label\":\"30 days\",\"offset\":{\"days\":30}},{\"label\":\"60 days\",\"offset\":{\"days\":60}},{\"label\":\"90 days\",\"offset\":{\"days\":90}},{\"label\":\"6 months\",\"offset\":{\"months\":6}},{\"label\":\"1 year\",\"offset\":{\"months\":12}}],\"repeatLast\":{\"months\":12}}"
        },
        {
          "name": "Every 90 days",
          "description": "Due 90 days after the date entered",
          "interval_days": 90,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Weekly contact",
          "note_types": [
            "meeting",
            "phone",
            "group"
          ],
          "per_month": 1,
          "period": "week"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "group",
