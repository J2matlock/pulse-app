{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "provider-credentialing",
  "name": "Provider credentialing",
  "description": "For a medical office: state licenses, DEA, board certification, malpractice, hospital privileges, CAQH re-attestation every 120 days and payer re-credentialing every 3 years. Pulse is a tracking aid, not your official record system.",
  "icon": "shield-check",
  "group": "Health",
  "keywords": [
    "credentialing",
    "medical staff",
    "license",
    "insurance panel"
  ],
  "vocab": {
    "record": {
      "one": "provider",
      "many": "providers",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "providers",
      "name": "Credentialing",
      "description": "Licenses, certifications and re-credentialing for each clinician",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Credentials",
          "column_type": "dropdown",
          "position": 1,
          "width": 120,
          "config": "{\"options\":[\"MD\",\"DO\",\"NP\",\"PA\",\"LCSW\",\"PhD\",\"Other\"]}"
        },
        {
          "name": "NPI",
          "column_type": "text",
          "position": 2,
          "width": 130,
          "is_required": 1
        },
        {
          "name": "State license expires",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "DEA expires",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Board certification expires",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "CAQH re-attestation",
          "column_type": "date",
          "position": 6,
          "width": 150,
          "description": "Date of the last CAQH re-attestation; due every 120 days",
          "config": "{\"alert_rule_name\":\"Every 120 days\",\"log_changes\":true}"
        },
        {
          "name": "Malpractice insurance expires",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Payer re-credentialing",
          "column_type": "date",
          "position": 8,
          "width": 150,
          "description": "Date of the last re-credentialing with payers; due every 3 years",
          "config": "{\"alert_rule_name\":\"Every 3 years\",\"log_changes\":true}"
        },
        {
          "name": "Hospital privileges expire",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (90-day warning)",
          "description": "The date entered is when it expires; warns 90, 60, 30, 7 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":90,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":7,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every 120 days",
          "description": "Due 120 days after the date entered",
          "interval_days": 120,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 3 years",
          "description": "Due 3 years after the date entered",
          "interval_months": 36,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "application",
      "label": "Application sent",
      "icon": "📨",
      "color": "blue"
    },
    {
      "key": "approved",
      "label": "Approved",
      "icon": "✅",
      "color": "green"
    }
  ],
