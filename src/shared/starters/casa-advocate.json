{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "casa-advocate",
  "name": "CASA / guardian ad litem",
  "description": "For court-appointed advocates: hearings, court reports due 10 business days before each hearing, and a visit every month.",
  "icon": "shield-check",
  "group": "Legal and government",
  "vocab": {
    "record": {
      "one": "child",
      "many": "children",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": true,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "children",
      "name": "Children",
      "description": "Children you advocate for, with hearings, court reports and monthly visits",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Case number",
          "column_type": "text",
          "position": 1,
          "width": 140
        },
        {
          "name": "Court",
          "column_type": "text",
          "position": 2,
          "width": 150
        },
        {
          "name": "Next hearing",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Court report filed",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date you filed the court report for the next hearing",
          "config": "{\"alert_rule_name\":\"Court report due\",\"log_changes\":true}"
        },
        {
          "name": "Last visit",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Placement",
          "column_type": "dropdown",
          "position": 6,
          "width": 140,
          "config": "{\"options\":[\"Foster home\",\"Kinship\",\"Group home\",\"With parent\",\"Other\"]}"
        },
        {
          "name": "Caregiver",
          "column_type": "text",
          "position": 7,
          "width": 160
        },
        {
          "name": "Caregiver phone",
          "column_type": "phone",
          "position": 8,
          "width": 140
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 9,
          "width": 110,
          "config": "{\"options\":[\"Active\",\"Closed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Court report due",
          "description": "The court report is due 10 business days before the hearing",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Next hearing\"},\"offset\":{\"businessDays\":10,\"direction\":\"before\"}}",
          "business_days": 1
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Visit",
          "note_types": [
            "visit"
          ],
          "per_month": 1
        }
      ]
    }
  ],
