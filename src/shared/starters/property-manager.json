{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "property-manager",
  "name": "Property manager",
  "description": "For landlords and small property managers: units with inspections, tenants with lease ends, and work orders on a board from new to done.",
  "icon": "building-2",
  "group": "Property and safety",
  "keywords": [
    "rental",
    "landlord",
    "tenant",
    "lease",
    "apartment",
    "property"
  ],
  "vocab": {
    "record": {
      "one": "record",
      "many": "records",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false,
    "links": true,
    "stages": true
  },
  "lists": [
    {
      "key": "units",
      "name": "Units",
      "description": "Rental units with inspections and status",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "unit",
          "many": "units",
          "article": "an"
        }
      },
      "columns": [
        {
          "name": "Unit",
          "column_type": "text",
          "position": 0,
          "width": 140,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Building",
          "column_type": "dropdown",
          "position": 1,
          "width": 180,
          "config": "{\"options\":[\"Maple Court\",\"Riverside Apartments\",\"Elm Street Duplex\"]}"
        },
        {
          "name": "Bedrooms",
          "column_type": "number",
          "position": 2,
          "width": 100
        },
        {
          "name": "Rent",
          "column_type": "currency",
          "position": 3,
          "width": 110
        },
        {
          "name": "Last inspection",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last unit inspection",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "Smoke detectors checked",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 6 months\",\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 6,
          "width": 140,
          "config": "{\"options\":[\"Occupied\",\"Vacant\",\"Make-ready\",\"Notice given\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    },
    {
      "key": "tenants",
      "name": "Tenants",
      "description": "Tenants and their leases",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "tenant",
          "many": "tenants",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 200
        },
        {
          "name": "Lease start",
          "column_type": "date",
          "position": 3,
          "width": 150
        },
        {
          "name": "Lease end",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (90-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Monthly rent",
          "column_type": "currency",
          "position": 5,
          "width": 130
        },
        {
          "name": "Deposit",
          "column_type": "currency",
          "position": 6,
          "width": 110
        },
        {
          "name": "Emergency contact",
          "column_type": "text",
          "position": 7,
          "width": 160
        }
      ],
      "alertRules": [
        {
          "name": "Expires (90-day warning)",
          "description": "The date entered is when it expires; warns 90, 60, 30 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":90,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":60,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":30,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        }
      ],
      "links": [
        {
          "to": "units",
          "label_forward": "Lives in",
          "label_backward": "Tenants",
          "cardinality": "many_to_one"
        }
      ]
    },
    {
      "key": "work-orders",
      "name": "Work orders",
      "description": "Repairs and maintenance requests",
      "kind": "job",
      "vocab": {
        "record": {
          "one": "work order",
          "many": "work orders",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Request",
          "column_type": "text",
          "position": 0,
          "width": 220,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Stage",
          "column_type": "status",
          "position": 1,
          "width": 140,
          "config": "{\"options\":[{\"label\":\"New\",\"color\":\"#64748b\"},{\"label\":\"Scheduled\",\"color\":\"#3b82f6\"},{\"label\":\"In progress\",\"color\":\"#f97316\"},{\"label\":\"Done\",\"color\":\"#22c55e\"}]}"
        },
        {
          "name": "Priority",
          "column_type": "dropdown",
          "position": 2,
          "width": 120,
          "config": "{\"options\":[\"Emergency\",\"Urgent\",\"Routine\"]}"
        },
        {
          "name": "Reported on",
          "column_type": "date",
          "position": 3,
          "width": 150
        },
        {
          "name": "Scheduled for",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Vendor",
          "column_type": "text",
          "position": 5,
          "width": 170
        },
        {
          "name": "Cost",
          "column_type": "currency",
          "position": 6,
          "width": 110
        },
        {
          "name": "Completed on",
          "column_type": "date",
          "position": 7,
          "width": 150
        }
      ],
      "alertRules": [
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "units",
          "label_forward": "Unit",
          "label_backward": "Work orders",
          "cardinality": "many_to_one"
        }
      ],
      "stage": {
        "column": "Stage",
        "options": [
          {
            "value": "New",
            "color": "slate"
          },
          {
            "value": "Scheduled",
            "color": "blue"
          },
          {
            "value": "In progress",
            "color": "orange"
          },
          {
            "value": "Done",
            "color": "green",
            "done": true,
            "onEnter": {
              "stampColumn": "Completed on"
            }
          }
        ],
        "hideDoneAfterDays": 30
      }
    }
  ],
  "documentTemplates": [
    {
      "name": "Lease renewal notice",
      "content": "{{today}}\n\nDear {{name}},\n\nYour lease for unit {{linked:Lives in.Unit}} ends on {{field:Lease end}}.\n\nWe would be glad to have you stay. Please let us know by the end of the month whether you plan to renew.\n\nSincerely,\n\n{{my_name}}"
    }
  ],
