{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "veterans-service-officer",
  "name": "Veterans service officer",
  "description": "For county and nonprofit veterans service officers: intent-to-file deadlines one year out, claims, the VA's 30-day evidence requests, decisions and appeal windows. Pulse is a tracking aid, not your official record system.",
  "icon": "shield-check",
  "group": "Legal and government",
  "keywords": [
    "veteran",
    "va",
    "claims",
    "military"
  ],
  "vocab": {
    "record": {
      "one": "veteran",
      "many": "veterans",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "veterans",
      "name": "Veterans",
      "description": "Veterans with intent-to-file deadlines, claims and appeal windows",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Claim filed",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "description": "Date the claim was filed",
          "config": "{\"alert_rule_name\":\"Intent to file expires\",\"log_changes\":true}"
        },
        {
          "name": "Appeal filed",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "description": "Date an appeal was filed, if any",
          "config": "{\"alert_rule_name\":\"Appeal window\",\"log_changes\":true}"
        },
        {
          "name": "Evidence sent",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "description": "Date you sent the evidence the VA asked for. Due 30 days after the VA letter date",
          "config": "{\"alert_rule_name\": \"Evidence due\", \"log_changes\": true}"
        },
        {
          "name": "Next appointment",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Branch",
          "column_type": "dropdown",
          "position": 5,
          "width": 130,
          "config": "{\"options\":[\"Army\",\"Navy\",\"Air Force\",\"Marine Corps\",\"Coast Guard\",\"Space Force\"]}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 6,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Claim type",
          "column_type": "dropdown",
          "position": 7,
          "width": 190,
          "config": "{\"options\":[\"Disability compensation\",\"Pension\",\"Education\",\"Health care\",\"Burial\"]}"
        },
        {
          "name": "Intent to file date",
          "column_type": "date",
          "position": 8,
          "width": 150
        },
        {
          "name": "Decision date",
          "column_type": "date",
          "position": 9,
          "width": 150
        },
        {
          "name": "VA letter date",
          "column_type": "date",
          "position": 10,
          "width": 150,
          "description": "Date on the VA's letter asking for evidence"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 11,
          "width": 160,
          "config": "{\"options\":[\"Gathering evidence\",\"Filed\",\"Decided\",\"Appealing\",\"Closed\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Intent to file expires",
          "description": "The claim must be filed within a year of the intent to file",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Intent to file date\"},\"offset\":{\"months\":12,\"direction\":\"after\"}}"
        },
        {
          "name": "Appeal window",
          "description": "A decision can be appealed for a year",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"Decision date\"},\"offset\":{\"months\":12,\"direction\":\"after\"}}"
        },
        {
          "name": "Evidence due",
          "description": "30 days from the date on the VA's evidence request letter",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "relative",
          "rule_config": "{\"kind\":\"relative\",\"anchorColumnId\":{\"column\":\"VA letter date\"},\"offset\":{\"days\":30,\"direction\":\"after\"}}"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "appointment",
      "label": "Office visit",
