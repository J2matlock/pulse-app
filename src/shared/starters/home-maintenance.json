  "helpTips": [
    {
      "title": "Manuals and receipts",
      "body": "Drop the manual, receipt and warranty card into Files on each item. They are stored encrypted inside Pulse, so they are there when something breaks."
    },
    {
      "title": "Spring and fall",
      "body": "Set Seasonal to \"Spring and fall\" on things like gutters and the AC. They come due at the end of April and the end of October. The spring and fall checklists cover the rest of the house."
    },
    {
      "title": "Filters",
      "body": "Write the filter size in Notes, so you buy the right one. When you change it, put today in Air filter changed and Pulse reminds you again in 90 days."
    },
    {
      "title": "Bills that repeat",
      "body": "After you pay a bill, change its Due date to the next one. Pulse warns you 30 days ahead."
    }
  ],
  "lists": [
    {
      "key": "items",
      "name": "Home items",
      "description": "The things in your home that need regular care",
      "kind": "thing",
      "vocab": {
        "record": {
          "one": "item",
          "many": "items",
          "article": "an"
        }
      },
      "columns": [
        {
          "name": "Item",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Where",
          "column_type": "text",
          "position": 1,
          "width": 140,
          "description": "Room or spot, e.g. Basement, Kitchen, North side of the house"
        },
        {
          "name": "Brand and model",
          "column_type": "text",
          "position": 2,
          "width": 170
        },
        {
          "name": "Installed",
          "column_type": "date",
          "position": 3,
          "width": 140
        },
        {
          "name": "Warranty ends",
          "column_type": "date",
          "position": 4,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Expires (60 days ahead)\", \"log_changes\": true}"
        },
        {
          "name": "Air filter changed",
          "column_type": "date",
          "position": 5,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 90 days\", \"log_changes\": true}",
          "description": "Furnace, AC or air purifier filter. Write the size in Notes"
        },
        {
          "name": "Water filter changed",
          "column_type": "date",
          "position": 6,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every 6 months\", \"log_changes\": true}",
          "description": "Refrigerator or under-sink water filter"
        },
        {
          "name": "Last serviced",
          "column_type": "date",
          "position": 7,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Yearly tune-up, flush or cleaning: furnace, water heater, dryer vent, roof check"
        },
        {
          "name": "Batteries changed",
          "column_type": "date",
          "position": 8,
          "width": 160,
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}",
          "description": "Smoke and CO detectors. Press the test button once a month too"
        },
        {
          "name": "Seasonal",
          "column_type": "dropdown",
          "position": 9,
          "width": 140,
          "description": "Choose \"Spring and fall\" for things that need care twice a year, like gutters",
          "config": "{\"options\": [\"Spring and fall\"]}"
        },
        {
          "name": "Spring and fall upkeep",
          "column_type": "deadline",
          "position": 10,
          "width": 170,
          "description": "Due at the end of April and the end of October; mark it done when it is done",
          "config": "{\"alert_rule_name\": \"Spring and fall\"}"
        },
        {
          "name": "Notes",
          "column_type": "notes",
          "position": 11,
          "width": 220
        }
      ],
      "alertRules": [
        {
          "name": "Every 90 days",
          "description": "Due 90 days after the date entered",
          "interval_days": 90,
          "thresholds": "[{\"daysBefore\": 7, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 3, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Expires (60 days ahead)",
          "description": "The date entered is when it runs out; warns 60 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 60, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 30, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 14, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]"
        },
        {
          "name": "Spring and fall",
          "description": "Due April 30 and October 30, for items marked Spring and fall",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\": 30, \"bgClass\": \"#bbf7d0\", \"label\": \"Coming up\"}, {\"daysBefore\": 14, \"bgClass\": \"#facc15\", \"label\": \"Due soon\"}, {\"daysBefore\": 7, \"bgClass\": \"#fb923c\", \"label\": \"Urgent\"}, {\"daysBefore\": 0, \"bgClass\": \"#dc2626\", \"label\": \"Due today\"}, {\"daysBefore\": -1, \"bgClass\": \"alert-pulse-dark\", \"label\": \"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\": \"calendar\", \"months\": [4, 10], \"day\": 30}",
          "rule_condition": "{\"columnId\": {\"column\": \"Seasonal\"}, \"op\": \"is\", \"values\": [\"Spring and fall\"], \"whenFalse\": \"hide\"}"
        }
      ],
      "checklists": [
        {
          "name": "Spring home checklist",
          "description": "Once the weather warms up",
          "items": "[\"Clean the gutters and downspouts\", \"Test the sump pump with a bucket of water\", \"Have the AC serviced before the first hot week\", \"Change the furnace or AC filter\", \"Check the roof and siding for winter damage\", \"Turn the outdoor faucets back on and check for leaks\", \"Test smoke and CO detectors\"]"
        },
        {
          "name": "Fall home checklist",
          "description": "Before the first freeze",
          "items": "[\"Clean the gutters after the leaves drop\", \"Have the furnace serviced\", \"Change the furnace filter\", \"Shut off and drain outdoor faucets\", \"Clean the dryer vent\", \"Change smoke and CO detector batteries\", \"Check weatherstripping on doors and windows\"]"
        }
      ],
      "links": [
        {
          "to": "pros",
          "label_forward": "Who services it",
          "label_backward": "Takes care of",
          "cardinality": "many_to_one"
        }
      ]
    },
