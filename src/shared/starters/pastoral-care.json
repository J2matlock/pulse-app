{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "pastoral-care",
  "name": "Pastoral care",
  "description": "For pastors and care teams: birthdays and anniversaries every year, bereavement care at 1, 3, 6 and 13 months after a loss, and regular visits.",
  "icon": "church",
  "group": "Faith and community",
  "vocab": {
    "record": {
      "one": "member",
      "many": "members",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "members",
      "name": "Care list",
      "description": "Members to remember on birthdays, anniversaries and after a loss",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 2,
          "width": 160
        },
        {
          "name": "Birthday",
          "column_type": "date",
          "position": 3,
          "width": 150
        },
        {
          "name": "Next birthday",
          "column_type": "deadline",
          "position": 4,
          "width": 140,
          "config": "{\"alert_rule_name\":\"Birthday\"}"
        },
        {
          "name": "Anniversary",
          "column_type": "date",
          "position": 5,
          "width": 150
        },
        {
          "name": "Next anniversary",
          "column_type": "deadline",
          "position": 6,
          "width": 140,
          "config": "{\"alert_rule_name\":\"Wedding anniversary\"}"
        },
        {
          "name": "Date of loss",
          "column_type": "date",
          "position": 7,
          "width": 150,
          "description": "When someone close to them died; bereavement care counts from here"
        },
        {
          "name": "Bereavement care",
          "column_type": "deadline",
          "position": 8,
          "width": 140,
          "description": "The next bereavement contact; mark it done to move on",
          "config": "{\"alert_rule_name\":\"Bereavement care\"}"
        },
        {
          "name": "Last visit",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 90 days\",\"log_changes\":true}"
        },
        {
          "name": "Care needs",
          "column_type": "tag",
          "position": 10,
          "width": 140,
          "description": "Homebound, hospital, grieving, new baby…"
        }
      ],
      "alertRules": [
        {
          "name": "Birthday",
          "description": "Each year on their birthday",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\":\"calendar\",\"fromColumnMonth\":{\"column\":\"Birthday\"},\"lead\":14}"
        },
        {
          "name": "Wedding anniversary",
          "description": "Each year on the anniversary",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\":\"calendar\",\"fromColumnMonth\":{\"column\":\"Anniversary\"},\"lead\":14}"
        },
        {
          "name": "Bereavement care",
          "description": "Reach out 1, 3, 6 and 13 months after a loss",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "sequence",
          "rule_config": "{\"kind\":\"sequence\",\"anchorColumnId\":{\"column\":\"Date of loss\"},\"steps\":[{\"label\":\"1 month\",\"offset\":{\"months\":1}},{\"label\":\"3 months\",\"offset\":{\"months\":3}},{\"label\":\"6 months\",\"offset\":{\"months\":6}},{\"label\":\"13 months\",\"offset\":{\"months\":13}}]}"
        },
        {
          "name": "Every 90 days",
          "description": "Due 90 days after the date entered",
          "interval_days": 90,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
