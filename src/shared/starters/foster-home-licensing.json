  "helpTips": [
    {
      "title": "Renewals and inspections",
      "body": "Type the date each was last done. License renewal and the fire and well water dates come due a year later, Last inspection 3 months later. Mark one done on its deadline to put in today's date."
    },
    {
      "title": "Well water",
      "body": "Leave Well water test blank for homes on city water: a blank date is never late."
    },
    {
      "title": "Training hours",
      "body": "Add each family's hours to Training hours this year as they finish courses, and log the course as a Training note. Sort by the column to see who is short before renewal."
    }
  ],
  "lists": [
    {
      "key": "homes",
      "name": "Foster homes",
      "description": "Licensed and pending foster homes with renewals, inspections and training hours",
      "kind": "person",
      "columns": [
        {
          "name": "Home",
          "column_type": "text",
          "position": 0,
          "width": 180,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "License renewal",
          "column_type": "date",
          "position": 1,
          "width": 150,
          "description": "Date the license was last renewed; due again a year later",
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}"
        },
        {
          "name": "Last inspection",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "description": "Date of the last home inspection; due again in 3 months",
          "config": "{\"alert_rule_name\": \"Every 3 months\", \"log_changes\": true}"
        },
        {
          "name": "Fire inspection",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "description": "Date of the last fire safety inspection; due again a year later",
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}"
        },
        {
          "name": "Well water test",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Only for homes on a private well. Date of the last test; due again a year later",
          "config": "{\"alert_rule_name\": \"Every year\", \"log_changes\": true}"
        },
        {
          "name": "Parents",
          "column_type": "text",
          "position": 5,
          "width": 200,
          "is_required": 1
        },
        {
          "name": "Training hours this year",
          "column_type": "number",
          "position": 6,
          "width": 120,
          "description": "Foster parent training hours finished this license year. Check your state's yearly minimum"
        },
        {
          "name": "County",
          "column_type": "text",
          "position": 7,
          "width": 130
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 8,
          "width": 130,
          "is_required": 1
        },
        {
          "name": "Address",
          "column_type": "address",
          "position": 9,
          "width": 200
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 130,
          "config": "{\"options\": [\"Licensed\", \"Pending\", \"On hold\", \"Closing\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every 3 months",
          "description": "Due 3 months after the date entered",
          "interval_months": 3,
          "thresholds": "[{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "dashboardCards": [
    "summary",
    "missingInfo"
  ],
