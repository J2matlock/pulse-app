{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "behavior-analyst",
  "name": "Behavior analyst (ABA)",
  "description": "For BCBAs and ABA practices: learners with authorized sessions counted as you log them, treatment plan reviews every 6 months, and technicians with RBT certification and monthly supervision. Pulse is a tracking aid, not your official record system.",
  "icon": "heart-handshake",
  "group": "Health",
  "keywords": [
    "aba",
    "bcba",
    "autism",
    "therapy"
  ],
  "vocab": {
    "record": {
      "one": "learner",
      "many": "learners",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": true,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
    "timeTracking": false,
    "mileage": false,
    "snippets": true,
    "checklists": true,
    "tasks": true,
    "focusMode": false,
    "letters": true,
    "summaryReport": true,
    "handoff": true,
    "links": true
  },
  "lists": [
    {
      "key": "learners",
      "name": "Learners",
      "description": "Learners with authorizations and treatment plan reviews",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 1,
          "width": 150
        },
        {
          "name": "Guardian",
          "column_type": "text",
          "position": 2,
          "width": 160
        },
        {
          "name": "Guardian phone",
          "column_type": "phone",
          "position": 3,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Funding",
          "column_type": "dropdown",
          "position": 4,
          "width": 160,
          "config": "{\"options\":[\"Medicaid\",\"Private insurance\",\"School district\",\"Self-pay\"]}"
        },
        {
          "name": "Sessions authorized",
          "column_type": "number",
          "position": 5,
          "width": 150
        },
        {
          "name": "Authorization start",
          "column_type": "date",
          "position": 6,
          "width": 150
        },
        {
          "name": "Authorization end",
          "column_type": "date",
          "position": 7,
          "width": 150
        },
        {
          "name": "Sessions left",
          "column_type": "deadline",
          "position": 8,
          "width": 140,
          "config": "{\"alert_rule_name\":\"Sessions left\"}"
        },
        {
          "name": "Treatment plan review",
          "column_type": "date",
          "position": 9,
          "width": 150,
          "description": "Date of the last treatment plan update; due again in 6 months",
          "config": "{\"alert_rule_name\":\"Every 6 months\",\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 10,
          "width": 130,
          "config": "{\"options\":[\"Active\",\"Assessment\",\"Waitlist\",\"Discharged\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Sessions left",
          "description": "Counts sessions between the authorization start and end dates",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "quota",
          "rule_config": "{\"kind\":\"quota\",\"activityTypes\":[\"session\"],\"limitColumnId\":{\"column\":\"Sessions authorized\"},\"startColumnId\":{\"column\":\"Authorization start\"},\"endColumnId\":{\"column\":\"Authorization end\"},\"warnRemaining\":4,\"warnDaysBeforeEnd\":21}"
        },
        {
          "name": "Every 6 months",
          "description": "Due 6 months after the date entered",
          "interval_months": 6,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "links": [
        {
          "to": "technicians",
          "label_forward": "Technician",
          "label_backward": "Learners",
          "cardinality": "many_to_one"
        }
      ]
    },
    {
      "key": "technicians",
      "name": "Technicians",
      "description": "Registered behavior technicians and their supervision",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "technician",
          "many": "technicians",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 1,
          "width": 140
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 2,
          "width": 200
        },
        {
          "name": "RBT certification expires",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "is_required": 1,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Last supervision",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last supervision session",
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "CPR expires",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Expires (60-day warning)\",\"log_changes\":true}"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 6,
          "width": 120,
          "config": "{\"options\":[\"Active\",\"On leave\",\"Former\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Expires (60-day warning)",
          "description": "The date entered is when it expires; warns 60, 30, 14 days ahead",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#facc15\",\"label\":\"Renew soon\"},{\"daysBefore\":30,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":14,\"bgClass\":\"#f87171\",\"label\":\"Expiring\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Expires today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Expired\"}]"
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
