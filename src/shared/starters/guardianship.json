  "lists": [
    {
      "key": "wards",
      "name": "Wards",
      "description": "People under guardianship or conservatorship",
      "kind": "person",
      "vocab": {
        "record": {
          "one": "ward",
          "many": "wards",
          "article": "a"
        }
      },
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Annual report",
          "column_type": "deadline",
          "position": 1,
          "width": 140,
          "description": "The yearly report to the court; mark it done when filed",
          "config": "{\"alert_rule_name\":\"Annual report to the court\"}"
        },
        {
          "name": "Last visit",
          "column_type": "date",
          "position": 2,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Every 30 days\",\"log_changes\":true}"
        },
        {
          "name": "Medicaid renewal",
          "column_type": "date",
          "position": 3,
          "width": 150,
          "config": "{\"alert_rule_name\":\"Due date\",\"log_changes\":true}"
        },
        {
          "name": "Date of birth",
          "column_type": "date",
          "position": 4,
          "width": 150
        },
        {
          "name": "Appointment date",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "is_required": 1,
          "description": "The date of the court order appointing you"
        },
        {
          "name": "Physician",
          "column_type": "text",
          "position": 6,
          "width": 160
        },
        {
          "name": "Powers",
          "column_type": "tag",
          "position": 7,
          "width": 140,
          "description": "Person, property, health care…"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 8,
          "width": 130,
          "config": "{\"options\":[\"Active\",\"Restored\",\"Deceased\",\"Transferred\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Annual report to the court",
          "description": "Due each year on the appointment anniversary",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]",
          "kind": "calendar",
          "rule_config": "{\"kind\":\"calendar\",\"fromColumnMonth\":{\"column\":\"Appointment date\"},\"lead\":60}"
        },
        {
          "name": "Every 30 days",
          "description": "Due 30 days after the date entered",
          "interval_days": 30,
          "thresholds": "[{\"daysBefore\":7,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":3,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Due date",
          "description": "The date entered is the deadline",
          "interval_days": 0,
          "thresholds": "[{\"daysBefore\":30,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":14,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":7,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ],
      "requirements": [
        {
          "label": "Visit",
          "note_types": [
            "visit"
          ],
          "per_month": 1
        }
      ],
      "links": [
        {
          "to": "facilities",
          "label_forward": "Lives at",
          "label_backward": "Residents",
          "cardinality": "many_to_one"
        }
      ]
