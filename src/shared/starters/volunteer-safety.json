{
  "pulse_template": "2.0",
  "type": "workspace",
  "id": "volunteer-safety",
  "name": "Youth volunteer safety",
  "description": "For churches, clubs and youth programs: background checks every 3 years and child safety training every year for everyone who serves with children.",
  "icon": "church",
  "group": "Faith and community",
  "keywords": [
    "volunteer",
    "background check",
    "training"
  ],
  "vocab": {
    "record": {
      "one": "volunteer",
      "many": "volunteers",
      "article": "a"
    },
    "list": {
      "one": "list",
      "many": "lists",
      "article": "a"
    },
    "activity": {
      "one": "note",
      "many": "notes",
      "article": "a"
    }
  },
  "suggestedFeatures": {
    "personFields": false,
    "priority": false,
    "contactsDirectory": false,
    "requirements": false,
