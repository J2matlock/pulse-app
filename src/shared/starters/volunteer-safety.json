    "focusMode": false,
    "letters": false,
    "summaryReport": true,
    "handoff": false
  },
  "lists": [
    {
      "key": "volunteers",
      "name": "Volunteers",
      "description": "Everyone who serves with children and youth, with their background checks and training",
      "kind": "person",
      "columns": [
        {
          "name": "Name",
          "column_type": "text",
          "position": 0,
          "width": 190,
          "is_name_column": 1,
          "is_identifier": 1,
          "is_required": 1
        },
        {
          "name": "Ministry or program",
          "column_type": "dropdown",
          "position": 1,
          "width": 170,
          "config": "{\"options\":[\"Nursery\",\"Children\",\"Youth\",\"Music\",\"Hospitality\",\"Transportation\"]}"
        },
        {
          "name": "Phone",
          "column_type": "phone",
          "position": 2,
          "width": 140,
          "is_required": 1
        },
        {
          "name": "Email",
          "column_type": "email",
          "position": 3,
          "width": 200
        },
        {
          "name": "Background check",
          "column_type": "date",
          "position": 4,
          "width": 150,
          "description": "Date of the last background check; due again every 3 years",
          "config": "{\"alert_rule_name\":\"Every 3 years\",\"log_changes\":true}"
        },
        {
          "name": "Child safety training",
          "column_type": "date",
          "position": 5,
          "width": 150,
          "description": "Date of the last child safety training; due again every year",
          "config": "{\"alert_rule_name\":\"Every year\",\"log_changes\":true}"
        },
        {
          "name": "References checked",
          "column_type": "checkbox",
          "position": 6,
          "width": 120
        },
        {
          "name": "Start date",
          "column_type": "date",
          "position": 7,
          "width": 150
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "position": 8,
          "width": 130,
          "config": "{\"options\":[\"Active\",\"Paused\",\"Stepped down\"]}"
        }
      ],
      "alertRules": [
        {
          "name": "Every 3 years",
          "description": "Due 3 years after the date entered",
          "interval_months": 36,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        },
        {
          "name": "Every year",
          "description": "Due on the same date a year later",
          "interval_months": 12,
          "thresholds": "[{\"daysBefore\":60,\"bgClass\":\"#bbf7d0\",\"label\":\"Coming up\"},{\"daysBefore\":30,\"bgClass\":\"#facc15\",\"label\":\"Due soon\"},{\"daysBefore\":14,\"bgClass\":\"#fb923c\",\"label\":\"Urgent\"},{\"daysBefore\":0,\"bgClass\":\"#dc2626\",\"label\":\"Due today\"},{\"daysBefore\":-1,\"bgClass\":\"alert-pulse-dark\",\"label\":\"Overdue\"}]"
        }
      ]
    }
  ],
  "activityTypes": [
    {
      "key": "note",
      "label": "Note",
      "icon": "📝",
      "color": "slate"
    },
    {
      "key": "training",
